{
  "id": "io.github.gor3pig.Pigoune",
  "runtime": "org.gnome.Platform",
  "runtime-version": "51",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "command": "pigoune",
  "separate-locales": false,
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=dri"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "env": {
      "CARGO_HOME": "/run/build/pigoune/cargo",
      "CARGO_NET_OFFLINE": "true"
    }
  },
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "/share/doc",
    "/share/man",
    "*.a",
    "*.la"
  ],
  "modules": [
    {
      "name": "ghostscript",
      "buildsystem": "autotools",
      "config-opts": [
        "--disable-cups",
        "--disable-gtk",
        "--disable-dbus",
        "--without-x",
        "--without-libpaper",
        "--without-tesseract",
        "--without-libidn",
        "--with-drivers=png16m,pngalpha,bbox,pdfwrite"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/ArtifexSoftware/ghostpdl-downloads/releases/download/gs10071/ghostscript-10.07.1.tar.xz",
          "sha256": "1cdb766de8db8f1e589c817f09c5855ea5f65dfc8540e465a69ac14c18416025"
        }
      ],
      "cleanup": [
        "/share/ghostscript/*/doc",
        "/share/ghostscript/*/examples",
        "/bin/dvipdf",
        "/bin/eps2eps",
        "/bin/gsbj",
        "/bin/gsdj",
        "/bin/gsdj500",
        "/bin/gslj",
        "/bin/gslp",
        "/bin/gsnd",
        "/bin/lprsetup.sh",
        "/bin/pdf2dsc",
        "/bin/pdf2ps",
        "/bin/pf2afm",
        "/bin/pfbtopfa",
        "/bin/pphs",
        "/bin/printafm",
        "/bin/ps2ascii",
        "/bin/ps2epsi",
        "/bin/ps2pdf",
        "/bin/ps2pdf1*",
        "/bin/ps2pdfwr",
        "/bin/ps2ps",
        "/bin/ps2ps2",
        "/bin/unix-lpr.sh"
      ]
    },
    {
      "name": "pigoune",
      "buildsystem": "meson",
      "config-opts": [
        "--buildtype=release"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "..",
          "skip": [
            "target",
            "_build",
            "build-dir",
            "repo",
            ".flatpak-builder",
            ".git"
          ]
        },
        "cargo-sources.json"
      ]
    }
  ]
}
