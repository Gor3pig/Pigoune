using Gtk 4.0;
using Adw 1;

template $PigouneAssetDetails: Adw.Bin {
  child: Stack stack {
    transition-type: crossfade;

    StackPage {
      name: "nothing";

      child: Adw.StatusPage {
        icon-name: "image-x-generic-symbolic";
        title: _("No Resource Selected");
        description: _("Select a resource to see its details.");

        styles [
          "compact",
        ]
      };
    }

    StackPage {
      name: "group";

      child: ScrolledWindow {
        hscrollbar-policy: never;

        child: Box {
          orientation: vertical;
          spacing: 18;
          margin-top: 24;
          margin-bottom: 18;
          margin-start: 18;
          margin-end: 18;

          Grid group_mosaic {
            halign: center;
            row-spacing: 4;
            column-spacing: 4;
          }

          Box {
            orientation: vertical;
            spacing: 4;

            Label group_title {
              wrap: true;
              justify: center;

              styles [
                "title-3",
              ]
            }

            Label group_summary {
              wrap: true;
              justify: center;

              styles [
                "dim-label",
              ]
            }
          }

          Button group_favorite_button {
            halign: center;
            action-name: "win.toggle-favorite";

            styles [
              "pill",
            ]
          }

          ListBox {
            selection-mode: none;

            styles [
              "boxed-list",
            ]

            ListBoxRow {
              activatable: false;

              child: $PigouneTagSummary group_tag_summary {
                margin-top: 10;
                margin-bottom: 10;
                margin-start: 12;
                margin-end: 12;
              };
            }

            ListBoxRow {
              activatable: false;

              child: $PigouneCollectionPlaces group_collection_places {
                margin-top: 10;
                margin-bottom: 10;
                margin-start: 12;
                margin-end: 12;
              };
            }
          }

          Button {
            label: _("Move to Trash");
            halign: center;
            action-name: "win.trash-selected";

            styles [
              "pill",
            ]
          }
        };
      };
    }

    StackPage {
      name: "trashed";

      child: Adw.StatusPage trashed_page {
        icon-name: "user-trash-symbolic";
        description: _("This selection is in the trash.");

        styles [
          "compact",
        ]

        child: Button {
          label: _("_Restore");
          use-underline: true;
          halign: center;
          action-name: "win.restore-selected";

          styles [
            "pill",
            "suggested-action",
          ]
        };
      };
    }

    StackPage {
      name: "asset";

      child: ScrolledWindow {
        hscrollbar-policy: never;

        child: Box {
          orientation: vertical;
          spacing: 18;
          margin-top: 18;
          margin-bottom: 18;
          margin-start: 18;
          margin-end: 18;

          Adw.Clamp preview_frame {
            maximum-size: 284;
            tightening-threshold: 284;

            Picture preview {
              height-request: 240;
              content-fit: contain;
              can-shrink: true;
            }
          }

          Box {
            orientation: vertical;
            spacing: 4;

            Box {
              spacing: 6;
              halign: center;

              EditableLabel name_label {
                xalign: 0.5;
                has-tooltip: true;

                styles [
                  "title-3",
                ]
              }

              Button favorite_button {
                valign: center;
                action-name: "win.toggle-favorite";

                styles [
                  "flat",
                  "circular",
                ]
              }
            }

            Label summary_label {
              wrap: true;
              justify: center;
              selectable: true;

              styles [
                "dim-label",
              ]
            }
          }

          Box action_buttons {
            spacing: 8;
            homogeneous: true;

            Button {
              action-name: "win.open-with";
              tooltip-text: _("Open With…");

              child: Box {
                orientation: vertical;
                spacing: 4;

                Image {
                  icon-name: "document-open-symbolic";
                }

                Label {
                  label: _("Open With…");
                  ellipsize: end;

                  styles [
                    "caption",
                  ]
                }
              };
            }

            Button {
              action-name: "win.copy-selected";
              tooltip-text: _("Copy");

              child: Box {
                orientation: vertical;
                spacing: 4;

                Image {
                  icon-name: "edit-copy-symbolic";
                }

                Label {
                  label: _("Copy");
                  ellipsize: end;

                  styles [
                    "caption",
                  ]
                }
              };
            }

            Button {
              action-name: "win.export-selected";
              tooltip-text: _("Export To…");

              child: Box {
                orientation: vertical;
                spacing: 4;

                Image {
                  icon-name: "document-send-symbolic";
                }

                Label {
                  label: _("Export…");
                  ellipsize: end;

                  styles [
                    "caption",
                  ]
                }
              };
            }
          }

          ListBox {
            selection-mode: none;

            styles [
              "boxed-list",
            ]

            Adw.ExpanderRow organization_row {
              title: _("Organization");

                  ListBoxRow {
                    activatable: false;

                    child: $PigouneTagSummary tag_summary {
                      margin-top: 10;
                      margin-bottom: 10;
                      margin-start: 12;
                      margin-end: 12;
                    };
                  }

                  ListBoxRow {
                    activatable: false;

                    child: $PigouneCollectionPlaces collection_places {
                      margin-top: 10;
                      margin-bottom: 10;
                      margin-start: 12;
                      margin-end: 12;
                    };
                  }

                  ListBoxRow color_row {
                    activatable: false;

                    child: $PigouneColorChips color_chips {
                      margin-top: 10;
                      margin-bottom: 10;
                      margin-start: 12;
                      margin-end: 12;
                    };
                  }
            }
          }

          ListBox {
            selection-mode: none;

            styles [
              "boxed-list",
            ]

            Adw.ExpanderRow credits_row {
              title: _("Note and Credits");

                ListBoxRow {
                  activatable: false;

                  child: Box {
                    orientation: vertical;
                    spacing: 6;
                    margin-top: 8;
                    margin-bottom: 8;
                    margin-start: 12;
                    margin-end: 12;

                    Label {
                      label: _("Note");
                      xalign: 0;

                      styles [
                        "caption",
                        "dim-label",
                      ]
                    }

                    TextView note_view {
                      wrap-mode: word_char;
                      accepts-tab: false;
                      height-request: 72;

                      styles [
                        "note-view",
                      ]
                    }
                  };
                }

                Adw.EntryRow source_row {
                  title: _("Source");

                  [suffix]
                  Button open_source_button {
                    icon-name: "web-browser-symbolic";
                    tooltip-text: _("Open the Link");
                    valign: center;
                    visible: false;
                    clicked => $on_open_source_clicked() swapped;

                    styles [
                      "flat",
                    ]
                  }
                }

                Adw.EntryRow license_row {
                  title: _("License");
                }

                Adw.EntryRow author_row {
                  title: _("Author");
                }
            }
          }

          ListBox {
            selection-mode: none;

            styles [
              "boxed-list",
            ]

            Adw.ExpanderRow file_row {
              title: _("File");

                ListBoxRow {
                  activatable: false;

                  child: Grid {
                    column-spacing: 14;
                    row-spacing: 6;
                    margin-top: 12;
                    margin-bottom: 12;
                    margin-start: 12;
                    margin-end: 12;

                    Label {
                      label: _("Original File");
                      xalign: 0;
                      yalign: 0;

                      layout {
                        column: 0;
                        row: 0;
                      }

                      styles [
                        "dim-label",
                      ]
                    }

                    Label original_value {
                      xalign: 0;
                      wrap: true;
                      wrap-mode: word_char;
                      selectable: true;
                      hexpand: true;

                      layout {
                        column: 1;
                        row: 0;
                      }
                    }

                    Label animation_title {
                      label: _("Animation");
                      xalign: 0;
                      yalign: 0;
                      visible: false;

                      layout {
                        column: 0;
                        row: 1;
                      }

                      styles [
                        "dim-label",
                      ]
                    }

                    Label animation_value {
                      xalign: 0;
                      wrap: true;
                      wrap-mode: word_char;
                      selectable: true;
                      hexpand: true;
                      visible: false;

                      layout {
                        column: 1;
                        row: 1;
                      }
                    }

                    Label embedded_title {
                      label: _("Contained Sizes");
                      xalign: 0;
                      yalign: 0;
                      visible: false;

                      layout {
                        column: 0;
                        row: 2;
                      }

                      styles [
                        "dim-label",
                      ]
                    }

                    Label embedded_value {
                      xalign: 0;
                      wrap: true;
                      wrap-mode: word_char;
                      selectable: true;
                      hexpand: true;
                      visible: false;

                      layout {
                        column: 1;
                        row: 2;
                      }
                    }
                  };
                }
            }
          }
        };
      };
    }
  };
}
