using Gtk 4.0;
using Adw 1;

template $PigouneAssetDetails: Adw.Bin {
  child: Stack stack {
    transition-type: crossfade;

    StackPage {
      name: "nothing";

      child: Adw.StatusPage {
        icon-name: "image-x-generic-symbolic";
        title: _("No Resource Selected");
        description: _("Select a resource to see its details.");

        styles [
          "compact",
        ]
      };
    }

    StackPage {
      name: "group";

      child: ScrolledWindow {
        hscrollbar-policy: never;

        child: Box {
          orientation: vertical;
          spacing: 18;
          margin-top: 24;
          margin-bottom: 18;
          margin-start: 18;
          margin-end: 18;

          Grid group_mosaic {
            halign: center;
            row-spacing: 4;
            column-spacing: 4;
          }

          Box {
            orientation: vertical;
            spacing: 4;

            Label group_title {
              wrap: true;
              justify: center;

              styles [
                "title-3",
              ]
            }

            Label group_summary {
              wrap: true;
              justify: center;

              styles [
                "dim-label",
              ]
            }
          }

          Button group_favorite_button {
            halign: center;
            action-name: "win.toggle-favorite";

            styles [
              "pill",
            ]
          }

          $PigouneTagSummary group_tag_summary {}

          $PigouneCollectionPlaces group_collection_places {}

          Button {
            label: _("Move to Trash");
            halign: center;
            action-name: "win.trash-selected";

            styles [
              "pill",
            ]
          }
        };
      };
    }

    StackPage {
      name: "trashed";

      child: Adw.StatusPage trashed_page {
        icon-name: "user-trash-symbolic";
        description: _("This selection is in the trash.");

        styles [
          "compact",
        ]

        child: Button {
          label: _("_Restore");
          use-underline: true;
          halign: center;
          action-name: "win.restore-selected";

          styles [
            "pill",
            "suggested-action",
          ]
        };
      };
    }

    StackPage {
      name: "asset";

      child: ScrolledWindow {
        hscrollbar-policy: never;

        child: Box {
          orientation: vertical;
          spacing: 18;
          margin-top: 18;
          margin-bottom: 18;
          margin-start: 18;
          margin-end: 18;

          Picture preview {
            height-request: 240;
            content-fit: contain;
            can-shrink: true;
          }

          Box {
            orientation: vertical;
            spacing: 4;

            Box {
              spacing: 6;
              halign: center;

              EditableLabel name_label {
                xalign: 0.5;
                tooltip-text: _("Rename (F2)");

                styles [
                  "title-3",
                ]
              }

              Button favorite_button {
                valign: center;
                action-name: "win.toggle-favorite";

                styles [
                  "flat",
                  "circular",
                ]
              }
            }

            Label summary_label {
              wrap: true;
              justify: center;
              selectable: true;

              styles [
                "dim-label",
              ]
            }
          }

          $PigouneTagSummary tag_summary {}

          Box {
            orientation: vertical;
            spacing: 6;

            Label {
              label: _("Information");
              xalign: 0;

              styles [
                "heading",
              ]
            }

            ListBox info_list {
              selection-mode: none;

              styles [
                "boxed-list",
              ]

              Adw.ActionRow format_row {
                title: _("Format");
                subtitle-selectable: true;

                styles [
                  "property",
                ]
              }

              Adw.ActionRow dimensions_row {
                title: _("Dimensions");
                subtitle-selectable: true;

                styles [
                  "property",
                ]
              }

              Adw.ActionRow size_row {
                title: _("Size");
                subtitle-selectable: true;

                styles [
                  "property",
                ]
              }

              Adw.ActionRow added_row {
                title: _("Added");
                subtitle-selectable: true;

                styles [
                  "property",
                ]
              }

              Adw.ActionRow original_row {
                title: _("Original File");
                subtitle-selectable: true;

                styles [
                  "property",
                ]
              }

              Adw.ActionRow animation_row {
                title: _("Animation");
                visible: false;

                styles [
                  "property",
                ]
              }

              Adw.ActionRow embedded_row {
                title: _("Contained Sizes");
                subtitle-selectable: true;
                visible: false;

                styles [
                  "property",
                ]
              }

              ListBoxRow {
                activatable: false;

                child: Box {
                  orientation: vertical;
                  spacing: 6;
                  margin-top: 8;
                  margin-bottom: 8;
                  margin-start: 12;
                  margin-end: 12;

                  Label {
                    label: _("Note");
                    xalign: 0;

                    styles [
                      "caption",
                      "dim-label",
                    ]
                  }

                  TextView note_view {
                    wrap-mode: word_char;
                    accepts-tab: false;
                    height-request: 72;

                    styles [
                      "note-view",
                    ]
                  }
                };
              }

              Adw.EntryRow source_row {
                title: _("Source");

                [suffix]
                Button open_source_button {
                  icon-name: "web-browser-symbolic";
                  tooltip-text: _("Open the Link");
                  valign: center;
                  visible: false;
                  clicked => $on_open_source_clicked() swapped;

                  styles [
                    "flat",
                  ]
                }
              }

              Adw.EntryRow license_row {
                title: _("License");
              }

              Adw.EntryRow author_row {
                title: _("Author");
              }
            }
          }

          $PigouneCollectionPlaces collection_places {}
        };
      };
    }
  };
}
