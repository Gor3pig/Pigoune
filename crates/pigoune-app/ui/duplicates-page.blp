using Gtk 4.0;
using Adw 1;

template $PigouneDuplicatesPage: Box {
  orientation: vertical;

  Stack stack {
    transition-type: crossfade;

    StackPage {
      name: "message";

      child: Adw.StatusPage message_page {
        vexpand: true;
        icon-name: "edit-copy-symbolic";
        title: _("Look for Possible Duplicates");
        description: _("Pigoune compares the drawings of your assets and groups those that look alike, such as the same logo in two formats or sizes. Nothing is changed or deleted until you choose.");

        styles [
          "compact",
        ]

        child: Box {
          orientation: vertical;
          spacing: 18;
          halign: center;
          width-request: 340;

          Button search_button {
            label: _("_Search");
            use-underline: true;
            halign: center;
            clicked => $on_search_clicked() swapped;

            styles [
              "pill",
              "suggested-action",
            ]
          }

          Button message_ignored_button {
            halign: center;
            visible: false;
            clicked => $on_ignored_clicked() swapped;
          }

          Button message_left_out_button {
            halign: center;
            visible: false;
            clicked => $on_left_out_clicked() swapped;
          }

          Box progress_box {
            orientation: vertical;
            spacing: 12;
            visible: false;

            ProgressBar progress_bar {}

            Button cancel_button {
              label: _("_Cancel");
              use-underline: true;
              halign: center;
              clicked => $on_cancel_clicked() swapped;

              styles [
                "pill",
              ]
            }
          }
        };
      };
    }

    StackPage {
      name: "results";

      child: ScrolledWindow scroller {
        vexpand: true;
        hscrollbar-policy: never;

        child: Adw.Clamp {
          maximum-size: 648;
          tightening-threshold: 560;

          child: Box {
            orientation: vertical;
            spacing: 18;
            margin-top: 18;
            margin-bottom: 24;
            margin-start: 24;
            margin-end: 24;

            Box results_bar {
              spacing: 12;

              Label caption_label {
                hexpand: true;
                xalign: 0;
                wrap: true;
                valign: center;

                styles [
                  "dim-label",
                ]
              }

              Button left_out_button {
                valign: center;
                visible: false;
                clicked => $on_left_out_clicked() swapped;
              }

              Button ignored_button {
                valign: center;
                visible: false;
                clicked => $on_ignored_clicked() swapped;
              }

              Button {
                label: _("_Search Again");
                use-underline: true;
                valign: center;
                clicked => $on_search_clicked() swapped;
              }
            }

            Box ignored_bar {
              orientation: vertical;
              spacing: 8;
              visible: false;

              Box {
                spacing: 12;

                Button back_button {
                  label: _("Back to _Results");
                  use-underline: true;
                  clicked => $on_back_clicked() swapped;
                }

                Box {
                  hexpand: true;
                }

                Button show_all_button {
                  label: _("Show _All Again…");
                  use-underline: true;
                  clicked => $on_show_all_clicked() swapped;
                }
              }

              Label {
                label: _("Ignored Duplicates");
                xalign: 0;
                margin-top: 6;

                styles [
                  "title-3",
                ]
              }

              Label ignored_caption_label {
                xalign: 0;
                wrap: true;

                styles [
                  "dim-label",
                ]
              }
            }

            Box groups_box {
              orientation: vertical;
              spacing: 18;
            }
          };
        };
      };
    }

    StackPage {
      name: "left-out";

      child: ScrolledWindow {
        vexpand: true;
        hscrollbar-policy: never;

        child: Adw.Clamp {
          maximum-size: 648;
          tightening-threshold: 560;

          child: Box {
            orientation: vertical;
            spacing: 12;
            margin-top: 18;
            margin-bottom: 24;
            margin-start: 24;
            margin-end: 24;

            Button {
              label: _("Back to _Results");
              use-underline: true;
              halign: start;
              clicked => $on_left_out_back_clicked() swapped;
            }

            Label {
              label: _("Collections Left Out");
              xalign: 0;
              margin-top: 6;

              styles [
                "title-3",
              ]
            }

            Label left_out_caption_label {
              xalign: 0;
              wrap: true;

              styles [
                "dim-label",
              ]
            }

            Box left_out_list {
              orientation: vertical;
              margin-top: 6;
            }
          };
        };
      };
    }
  }
}
