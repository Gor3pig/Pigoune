using Gtk 4.0;
using Adw 1;

template $PigouneEditor: Adw.Bin {
  child: Adw.BottomSheet bottom_sheet {
    full-width: true;
    reveal-bottom-bar: bind template.compact;

    content: Adw.OverlaySplitView split_view {
      sidebar-position: end;
      min-sidebar-width: 320;
      max-sidebar-width: 320;
      collapsed: bind template.compact;
      show-sidebar: bind template.compact inverted;

      content: Adw.ToolbarView {
        [top]
        Adw.HeaderBar left_header {
          show-title: false;
          show-end-title-buttons: bind template.compact;

          [start]
          Button {
            tooltip-text: _("Back to the Library");
            visible: bind template.compact inverted;
            clicked => $on_back_clicked() swapped;

            child: Adw.ButtonContent {
              icon-name: "go-previous-symbolic";
              label: _("Library");
            };
          }

          [start]
          Button {
            icon-name: "go-previous-symbolic";
            tooltip-text: _("Back to the Library");
            visible: bind template.compact;
            clicked => $on_back_clicked() swapped;
          }

          [start]
          Button undo_button {
            icon-name: "edit-undo-symbolic";
            tooltip-text: _("Undo");
            sensitive: false;
            clicked => $on_undo_clicked() swapped;
          }

          [start]
          Button redo_button {
            icon-name: "edit-redo-symbolic";
            tooltip-text: _("Redo");
            sensitive: false;
            clicked => $on_redo_clicked() swapped;
          }
        }

        content: Overlay canvas_overlay {
          child: $PigouneZoomView zoom_view {};

          [overlay]
          TextView text_view {
            visible: false;
            halign: start;
            valign: start;
            accepts-tab: false;
            top-margin: 2;
            bottom-margin: 2;
            left-margin: 4;
            right-margin: 4;

            styles [
              "annotation-editor",
            ]
          }

          [overlay]
          Revealer mask_notice {
            halign: center;
            valign: start;
            margin-top: 12;
            margin-start: 12;
            margin-end: 12;
            transition-type: slide_down;
            reveal-child: false;

            child: Box {
              accessible-role: alert;
              spacing: 12;

              styles [
                "toolbar",
                "osd",
              ]

              Image {
                icon-name: "dialog-warning-symbolic";
              }

              Label mask_notice_label {
                wrap: true;
                max-width-chars: 44;
                xalign: 0;
              }

              Button {
                label: _("_Show Hidden Effects");
                use-underline: true;
                valign: center;
                clicked => $on_show_hidden_effects_clicked() swapped;
              }
            };
          }
        };

        [bottom]
        Box status_bar {
          spacing: 6;
          visible: bind template.compact inverted;

          styles [
            "toolbar",
          ]

          Button zoom_out_button {
            icon-name: "zoom-out-symbolic";
            tooltip-text: _("Zoom Out");

            styles [
              "flat",
            ]
          }

          Button zoom_button {
            tooltip-text: _("Fit to Window");

            styles [
              "flat",
            ]
          }

          Button zoom_in_button {
            icon-name: "zoom-in-symbolic";
            tooltip-text: _("Zoom In");

            styles [
              "flat",
            ]
          }

          Label annotations_label {
            hexpand: true;
            halign: end;
            label: _("No annotations");

            styles [
              "dim-label",
            ]
          }
        }
      };

      sidebar: Adw.ToolbarView panel_view {
        styles [
          "editor-panel",
        ]

        [top]
        Adw.HeaderBar right_header {
          show-title: false;
          show-start-title-buttons: false;

          [end]
          Button save_button {
            label: _("Save");
            sensitive: false;

            styles [
              "suggested-action",
            ]
          }

          [end]
          MenuButton output_button {
            icon-name: "view-more-symbolic";
            tooltip-text: _("Copy or Export");
            sensitive: false;
          }

          [end]
          Button capture_button {
            icon-name: "camera-photo-symbolic";
            tooltip-text: _("Take a Screenshot to Annotate");
            action-name: "win.capture";
            focus-on-click: false;
          }
        }

        content: Box panel {
          orientation: vertical;
          spacing: 12;
          margin-top: 12;
          margin-bottom: 12;
          margin-start: 12;
          margin-end: 12;

          Adw.PreferencesGroup tools_group {
            title: _("Tools");

            Grid tools_grid {
              column-spacing: 6;
              row-spacing: 6;
              column-homogeneous: true;
            }
          }

          Box sections_host {
            orientation: vertical;
            vexpand: true;

            Paned sections_paned {
              orientation: vertical;
              vexpand: true;
              wide-handle: true;
              resize-start-child: true;
              resize-end-child: true;
              shrink-start-child: false;
              shrink-end-child: false;
              visible: bind template.compact inverted;

              [start]
              Box properties_section {
                orientation: vertical;
                spacing: 6;

                ToggleButton properties_toggle {
                  active: true;
                  tooltip-text: _("Show or Hide the Properties");

                  styles [
                    "flat",
                  ]

                  child: Box {
                    spacing: 6;

                    Image properties_arrow {
                      icon-name: "pan-down-symbolic";
                    }

                    Label {
                      label: _("Properties");
                      halign: start;
                      hexpand: true;

                      styles [
                        "heading",
                      ]
                    }
                  };
                }

                ScrolledWindow properties_scroller {
                  hscrollbar-policy: never;
                  vexpand: true;
                  min-content-height: 60;

                  child: Box properties_box {
                    orientation: vertical;
                    spacing: 24;

                    Adw.PreferencesGroup style_group {}

                Adw.PreferencesGroup crop_group {
                  title: _("Crop");
                  visible: false;

                  Adw.ComboRow crop_ratio_row {
                    title: _("Aspect Ratio");

                    model: StringList {
                      strings [
                        _("Free"),
                        _("Same as Image"),
                        _("Square"),
                        "4:3",
                        "16:9",
                      ]
                    };
                  }

                  Adw.ActionRow crop_size_row {
                    title: _("Crop Size");

                    styles [
                      "property",
                    ]
                  }

                  ListBoxRow {
                    activatable: false;
                    selectable: false;

                    child: Box {
                      orientation: vertical;
                      spacing: 6;
                      margin-top: 12;
                      margin-bottom: 12;
                      margin-start: 12;
                      margin-end: 12;

                      Button {
                        label: _("Apply");
                        clicked => $on_crop_apply_clicked() swapped;

                        styles [
                          "suggested-action",
                        ]
                      }

                      Box {
                        spacing: 6;
                        homogeneous: true;

                        Button {
                          label: _("Cancel");
                          clicked => $on_crop_cancel_clicked() swapped;
                        }

                        Button {
                          label: _("Reset");
                          clicked => $on_crop_reset_clicked() swapped;
                        }
                      }
                    };
                  }
                }
                  };
                }
              }

              [end]
              Box layers_section {
                orientation: vertical;
                spacing: 6;
                margin-top: 6;

                Box {
                  spacing: 6;

                  Label layers_heading {
                    label: _("Layers");
                    halign: start;
                    hexpand: true;

                    styles [
                      "heading",
                    ]
                  }

                  Box layer_buttons {
                    spacing: 2;
                  }
                }

                ScrolledWindow layers_scroller {
                  hscrollbar-policy: never;
                  vexpand: true;
                  min-content-height: 90;

                  child: ListBox layers_list {
                    selection-mode: single;

                    styles [
                      "boxed-list",
                      "layers-list",
                    ]
                  };
                }
              }
            }

            Box compact_sections {
              orientation: vertical;
              spacing: 6;
              vexpand: true;
              visible: bind template.compact;

              Adw.InlineViewSwitcher sections_switcher {
                stack: sections_stack;
                display-mode: labels;
                homogeneous: true;
              }

              Adw.ViewStack sections_stack {
                vexpand: true;
              }
            }
          }
        };
      };
    };

    sheet: Adw.Bin sheet_bin {};

    bottom-bar: Box {
      spacing: 10;
      margin-top: 8;
      margin-bottom: 8;
      margin-start: 12;
      margin-end: 12;

      Image bar_icon {}

      Label bar_label {
        styles [
          "heading",
        ]
      }

      Label {
        hexpand: true;
        halign: end;
        label: _("Tools and Settings");

        styles [
          "dim-label",
        ]
      }

      Image {
        icon-name: "go-up-symbolic";
      }
    };
  };
}
