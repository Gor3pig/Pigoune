using Gtk 4.0;
using Adw 1;

template $PigouneEditor: Adw.Bin {
  child: Adw.BottomSheet bottom_sheet {
    full-width: true;
    reveal-bottom-bar: bind template.compact;

    content: Adw.OverlaySplitView split_view {
      sidebar-position: end;
      min-sidebar-width: 320;
      max-sidebar-width: 320;
      collapsed: bind template.compact;
      show-sidebar: bind template.compact inverted;

      content: Adw.ToolbarView {
        [top]
        Adw.HeaderBar left_header {
          show-title: false;
          show-end-title-buttons: bind template.compact;

          [start]
          Button {
            tooltip-text: _("Back to the Library");
            visible: bind template.compact inverted;
            clicked => $on_back_clicked() swapped;

            child: Adw.ButtonContent {
              icon-name: "go-previous-symbolic";
              label: _("Library");
            };
          }

          [start]
          Button {
            icon-name: "go-previous-symbolic";
            tooltip-text: _("Back to the Library");
            visible: bind template.compact;
            clicked => $on_back_clicked() swapped;
          }

          [start]
          Button undo_button {
            icon-name: "edit-undo-symbolic";
            tooltip-text: _("Undo");
            sensitive: false;
            clicked => $on_undo_clicked() swapped;
          }

          [start]
          Button redo_button {
            icon-name: "edit-redo-symbolic";
            tooltip-text: _("Redo");
            sensitive: false;
            clicked => $on_redo_clicked() swapped;
          }
        }

        content: $PigouneZoomView zoom_view {};

        [bottom]
        Box status_bar {
          spacing: 6;
          visible: bind template.compact inverted;

          styles [
            "toolbar",
          ]

          Button zoom_out_button {
            icon-name: "zoom-out-symbolic";
            tooltip-text: _("Zoom Out");

            styles [
              "flat",
            ]
          }

          Button zoom_button {
            tooltip-text: _("Fit to Window");

            styles [
              "flat",
            ]
          }

          Button zoom_in_button {
            icon-name: "zoom-in-symbolic";
            tooltip-text: _("Zoom In");

            styles [
              "flat",
            ]
          }

          Label annotations_label {
            hexpand: true;
            halign: end;
            label: _("No annotations");

            styles [
              "dim-label",
            ]
          }
        }
      };

      sidebar: Adw.ToolbarView panel_view {
        styles [
          "editor-panel",
        ]

        [top]
        Adw.HeaderBar right_header {
          show-title: false;
          show-start-title-buttons: false;

          [end]
          Button save_button {
            label: _("Save");
            sensitive: false;

            styles [
              "suggested-action",
            ]
          }

          [end]
          MenuButton output_button {
            icon-name: "view-more-symbolic";
            tooltip-text: _("Copy or Export");
            sensitive: false;
          }
        }

        content: ScrolledWindow panel {
          hscrollbar-policy: never;
          min-content-height: 360;

          child: Box {
            orientation: vertical;
            spacing: 24;
            margin-top: 12;
            margin-bottom: 12;
            margin-start: 12;
            margin-end: 12;

            Adw.PreferencesGroup tools_group {
              title: _("Tools");

              Grid tools_grid {
                column-spacing: 6;
                row-spacing: 6;
                column-homogeneous: true;
              }
            }

            Adw.PreferencesGroup style_group {
              ListBoxRow {
                activatable: false;
                selectable: false;

                child: Box color_swatches {
                  spacing: 8;
                  margin-top: 12;
                  margin-bottom: 12;
                  margin-start: 12;
                  margin-end: 12;
                  halign: start;
                };
              }

              Adw.ActionRow {
                title: _("Thickness");

                [suffix]
                Scale thickness_scale {
                  width-request: 140;
                  valign: center;
                  draw-value: false;

                  adjustment: Adjustment {
                    lower: 1;
                    upper: 60;
                    value: 6;
                  };
                }
              }

              Adw.ActionRow {
                title: _("Opacity");

                [suffix]
                Scale opacity_scale {
                  width-request: 140;
                  valign: center;
                  draw-value: false;

                  adjustment: Adjustment {
                    lower: 5;
                    upper: 100;
                    value: 100;
                  };
                }
              }
            }

Adw.PreferencesGroup {
              title: _("Layers");
              description: _("Nothing to show yet");
            }

            Adw.PreferencesGroup {
              title: _("Frame");

              Adw.SwitchRow {
                title: _("Border, Shadow and Background");
                sensitive: false;
              }
            }
          };
        };
      };
    };

    sheet: Adw.Bin sheet_bin {};

    bottom-bar: Box {
      spacing: 10;
      margin-top: 8;
      margin-bottom: 8;
      margin-start: 12;
      margin-end: 12;

      Image bar_icon {}

      Label bar_label {
        styles [
          "heading",
        ]
      }

      Label {
        hexpand: true;
        halign: end;
        label: _("Tools and Settings");

        styles [
          "dim-label",
        ]
      }

      Image {
        icon-name: "go-up-symbolic";
      }
    };
  };
}
