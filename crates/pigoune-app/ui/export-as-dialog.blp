using Gtk 4.0;
using Adw 1;

template $PigouneExportAsDialog: Adw.Dialog {
  title: _("Export As");
  follows-content-size: true;
  default-widget: export_button;

  child: Adw.ToolbarView {
    width-request: 420;

    [top]
    Adw.HeaderBar {
      show-start-title-buttons: false;
      show-end-title-buttons: false;

      [start]
      Button {
        label: _("_Cancel");
        use-underline: true;
        clicked => $on_cancel_clicked() swapped;
      }

      [end]
      Button export_button {
        label: _("_Export…");
        use-underline: true;
        clicked => $on_export_clicked() swapped;

        styles [
          "suggested-action",
        ]
      }
    }

    content: Box {
      orientation: vertical;
      margin-top: 12;
      margin-bottom: 24;
      margin-start: 12;
      margin-end: 12;

      ListBox {
        selection-mode: none;

        styles [
          "boxed-list",
        ]

        Adw.ComboRow format_row {
          title: _("Format");
          notify::selected => $on_format_changed() swapped;
        }

        Adw.SwitchRow screen_row {
          title: _("Size of My Screen");
          notify::active => $on_screen_changed() swapped;
        }

        Adw.ActionRow framing_row {
          title: _("Framing");

          [suffix]
          Adw.ToggleGroup framing_toggles {
            valign: center;
            active-name: "fill";
            notify::active-name => $on_framing_changed() swapped;

            Adw.Toggle {
              name: "fill";
              label: _("Fill the Screen");
            }

            Adw.Toggle {
              name: "fit";
              label: _("Whole Image");
            }
          }
        }

        ListBoxRow dimensions_row {
          activatable: false;

          child: Box {
            orientation: vertical;
            spacing: 6;
            margin-top: 12;
            margin-bottom: 12;
            margin-start: 12;
            margin-end: 12;

            Grid {
              column-spacing: 12;
              row-spacing: 6;

              Label {
                label: _("Width");
                xalign: 0;
                hexpand: true;

                layout {
                  column: 0;
                  row: 0;
                }
              }

              SpinButton width_spin {
                numeric: true;
                valign: center;
                value-changed => $on_width_changed() swapped;

                adjustment: Adjustment {
                  lower: 1;
                  upper: 32768;
                  step-increment: 1;
                  page-increment: 10;
                };

                layout {
                  column: 1;
                  row: 0;
                }
              }

              Label {
                label: _("Height");
                xalign: 0;

                layout {
                  column: 0;
                  row: 1;
                }
              }

              SpinButton height_spin {
                numeric: true;
                valign: center;
                value-changed => $on_height_changed() swapped;

                adjustment: Adjustment {
                  lower: 1;
                  upper: 32768;
                  step-increment: 1;
                  page-increment: 10;
                };

                layout {
                  column: 1;
                  row: 1;
                }
              }

              ToggleButton link_button {
                icon-name: "changes-prevent-symbolic";
                tooltip-text: _("Keep Proportions");
                valign: center;
                toggled => $on_link_toggled() swapped;

                layout {
                  column: 2;
                  row: 0;
                  row-span: 2;
                }
              }

              DropDown unit_dropdown {
                valign: center;
                notify::selected => $on_unit_changed() swapped;

                model: StringList {
                  strings [
                    _("pixels"),
                    "%",
                  ]
                };

                layout {
                  column: 3;
                  row: 0;
                  row-span: 2;
                }
              }
            }

            Label several_hint {
              xalign: 0;
              wrap: true;
              visible: false;

              styles [
                "caption",
              ]
            }

            Label {
              label: _("A pixel image that is enlarged becomes blurry; SVG images stay sharp");
              xalign: 0;
              wrap: true;

              styles [
                "dim-label",
                "caption",
              ]
            }
          };
        }

        ListBoxRow icon_sides_row {
          activatable: false;

          child: Box {
            orientation: vertical;
            spacing: 6;
            margin-top: 12;
            margin-bottom: 12;
            margin-start: 12;
            margin-end: 12;

            Label {
              label: _("Icon Sizes");
              xalign: 0;
            }

            Label {
              label: _("Sizes larger than a pixel image are skipped");
              xalign: 0;
              wrap: true;

              styles [
                "dim-label",
                "caption",
              ]
            }

            FlowBox icon_sides_box {
              selection-mode: none;
              min-children-per-line: 4;
              max-children-per-line: 4;
              homogeneous: true;
            }
          };
        }

        Adw.SpinRow quality_row {
          title: _("Quality");
          subtitle: _("A higher quality makes larger files");

          adjustment: Adjustment {
            lower: 1;
            upper: 100;
            step-increment: 1;
            page-increment: 10;
            value: 90;
          };
        }

        Adw.SwitchRow transparency_row {
          title: _("Keep Transparency");
          active: true;
          notify::active => $on_transparency_changed() swapped;
        }

        Adw.ActionRow background_row {
          title: _("Background");
          subtitle: _("Fills the transparent areas");
          activatable-widget: background_button;

          [suffix]
          ColorDialogButton background_button {
            valign: center;

            dialog: ColorDialog {
              with-alpha: false;
            };
          }
        }
      }
    };
  };
}
