using Gtk 4.0;
using Adw 1;

template $PigouneGridHeader: Adw.Bin {
  child: Box {
    orientation: vertical;

    Adw.HeaderBar {
    show-title: false;

    [start]
    ToggleButton sidebar_button {
      visible: bind template.narrow;
      icon-name: "sidebar-show-symbolic";
      tooltip-text: _("Show the Sidebar");
    }

    [start]
    Box search_slot {
    $PigouneSearchSpace search_space {
      Overlay {
        child: SearchEntry search_entry {
          max-width-chars: 24;
          placeholder-text: _("Search…");

          accessibility {
            label: _("Search Assets");
          }
        };

        [overlay]
        MenuButton scope_button {
          visible: false;
          halign: start;
          valign: center;
          margin-start: 30;
          tooltip-text: _("Where to Search");

          child: Box {
            spacing: 5;

            Image scope_icon {
              icon-name: "folder-symbolic";
            }

            Label scope_label {
              ellipsize: end;
              max-width-chars: 14;
            }

            Image scope_arrow {
              icon-name: "pan-down-symbolic";
            }
          };

          accessibility {
            label: _("Search Scope");
          }

          styles [
            "flat",
            "scope-chip",
          ]
        }
      }

      MenuButton filter_button {
        label: _("Filters");
        always-show-arrow: true;
        tooltip-text: _("Filter the Assets");

        popover: $PigouneFilterPopover filter_popover {};

        styles [
          "flat",
        ]
      }
    }

    }

    [end]
    ToggleButton details_button {
      visible: false;
      active: true;
      icon-name: "sidebar-show-right-symbolic";
      tooltip-text: _("Show Details");
    }

    [end]
    Button {
      visible: bind template.narrow inverted;
      icon-name: "zoom-in-symbolic";
      tooltip-text: _("Larger Thumbnails");
      action-name: "win.enlarge-thumbnails";

      styles [
        "flat",
        "circular",
      ]
    }

    [end]
    Scale {
      visible: bind template.compact inverted;
      width-request: 120;
      draw-value: false;
      tooltip-text: _("Thumbnail Size");

      adjustment: Adjustment size_adjustment {
        lower: 64;
        upper: 256;
        step-increment: 32;
        page-increment: 32;
      };

      accessibility {
        label: _("Thumbnail Size");
      }
    }

    [end]
    Button {
      visible: bind template.narrow inverted;
      icon-name: "zoom-out-symbolic";
      tooltip-text: _("Smaller Thumbnails");
      action-name: "win.shrink-thumbnails";

      styles [
        "flat",
        "circular",
      ]
    }

    [end]
    MenuButton sort_button {
      icon-name: "view-sort-descending-symbolic";
      menu-model: sort_menu;

      styles [
        "flat",
      ]
    }

    [end]
    ToggleButton search_button {
      visible: bind template.tight;
      icon-name: "system-search-symbolic";
      tooltip-text: _("Search");
    }
    }

    SearchBar search_bar {
      child: Box search_bar_slot {};
    }
  };
}

menu sort_menu {
  section {
    label: _("Sort By");

    item {
      label: _("Date Added");
      action: "win.sort-criterion";
      target: "added";
    }

    item {
      label: _("Name");
      action: "win.sort-criterion";
      target: "name";
    }

    item {
      label: _("Type");
      action: "win.sort-criterion";
      target: "type";
    }

    item {
      label: _("Dimensions");
      action: "win.sort-criterion";
      target: "dimensions";
    }

    item {
      label: _("Size");
      action: "win.sort-criterion";
      target: "size";
    }
  }

  section {
    item {
      label: _("Reverse Order");
      action: "win.sort-reversed";
    }
  }
}
