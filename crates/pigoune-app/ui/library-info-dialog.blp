using Gtk 4.0;
using Adw 1;

template $PigouneLibraryInfoDialog: Adw.Dialog {
  title: _("Manage Library");
  content-width: 900;
  width-request: 360;
  height-request: 400;

  Adw.Breakpoint {
    condition ("max-width: 860sp")

    setters {
      switcher_bar.reveal: true;
      header_bar.title-widget: window_title;
    }
  }

  child: Adw.ToolbarView toolbar {
    [top]
    Adw.HeaderBar header_bar {
      title-widget: Adw.ViewSwitcher {
        stack: pages;
        policy: wide;
      };
    }

    [bottom]
    Adw.ViewSwitcherBar switcher_bar {
      stack: pages;
    }

    content: Adw.ToastOverlay toast_overlay {
      child: Adw.ViewStack pages {
        vhomogeneous: true;
        hhomogeneous: true;

        Adw.ViewStackPage {
          name: "overview";
          title: _("Overview");
          icon-name: "view-grid-symbolic";

          child: ScrolledWindow {
            hscrollbar-policy: never;
            propagate-natural-height: true;

            child: Adw.Clamp {
              maximum-size: 648;
              tightening-threshold: 560;

              child: Box {
                orientation: vertical;
                spacing: 18;
                margin-top: 18;
                margin-bottom: 24;
                margin-start: 24;
                margin-end: 24;

                Box {
                  orientation: vertical;
                  spacing: 2;

                  Label name_label {
                    halign: start;
                    xalign: 0;
                    wrap: true;
                    max-width-chars: 40;
                    justify: left;

                    styles [
                      "title-2",
                    ]
                  }

                  Label place_label {
                    halign: start;
                    xalign: 0;
                    ellipsize: middle;
                    max-width-chars: 60;
                    justify: left;

                    styles [
                      "caption",
                      "dim-label",
                    ]
                  }
                }

                ListBox figures_list {
                  selection-mode: none;

                  styles [
                    "boxed-list",
                  ]
                }

                Box records_box {
                  orientation: vertical;
                  spacing: 6;

                  Label {
                    label: _("Records");
                    xalign: 0;

                    styles [
                      "heading",
                    ]
                  }

                  ListBox records_list {
                    selection-mode: none;
                    row-activated => $on_record_activated() swapped;

                    styles [
                      "boxed-list",
                    ]
                  }
                }
              };
            };
          };
        }

        Adw.ViewStackPage {
          name: "content";
          title: _("Content");
          icon-name: "image-x-generic-symbolic";

          child: ScrolledWindow {
            hscrollbar-policy: never;
            propagate-natural-height: true;

            child: Adw.Clamp {
              maximum-size: 648;
              tightening-threshold: 560;

              child: Box {
                orientation: vertical;
                spacing: 18;
                margin-top: 18;
                margin-bottom: 24;
                margin-start: 24;
                margin-end: 24;

                Box chart_box {
                  orientation: vertical;
                  spacing: 14;

                  styles [
                    "card",
                    "info-card",
                  ]

                  Adw.WrapBox {
                    child-spacing: 24;
                    line-spacing: 12;
                    align: 0.5;

                    Overlay {
                      valign: center;

                      child: $PigouneRingChart ring_chart {};

                      [overlay]
                      Box {
                        orientation: vertical;
                        halign: center;
                        valign: center;

                        Label total_label {
                          styles [
                            "title-3",
                            "numeric",
                          ]
                        }

                        Label total_caption {
                          styles [
                            "caption",
                            "dim-label",
                          ]
                        }
                      }
                    }

                    Grid legend_grid {
                      valign: center;
                      column-spacing: 12;
                      row-spacing: 6;
                    }
                  }

                  Adw.ToggleGroup measure_toggles {
                    halign: center;
                    active-name: "weight";
                    notify::active-name => $on_measure_changed() swapped;

                    Adw.Toggle {
                      name: "weight";
                      label: _("Size");
                    }

                    Adw.Toggle {
                      name: "count";
                      label: _("Number");
                    }
                  }
                }

                Adw.WrapBox counts_box {
                  child-spacing: 6;
                  line-spacing: 6;
                  align: 0;
                }

                Box colors_box {
                  orientation: vertical;
                  spacing: 8;

                  Label {
                    label: _("Detected Colors");
                    xalign: 0;

                    styles [
                      "heading",
                    ]
                  }

                  Box {
                    orientation: vertical;
                    spacing: 12;

                    styles [
                      "card",
                      "info-card",
                    ]

                    $PigouneStackedBar colors_bar {}

                    Adw.WrapBox colors_legend {
                      child-spacing: 6;
                      line-spacing: 6;
                    }
                  }
                }
              };
            };
          };
        }

        Adw.ViewStackPage {
          name: "storage";
          title: _("Storage");
          icon-name: "drive-harddisk-symbolic";

          child: ScrolledWindow {
            hscrollbar-policy: never;
            propagate-natural-height: true;

            child: Adw.Clamp {
              maximum-size: 648;
              tightening-threshold: 560;

              child: Box {
                orientation: vertical;
                spacing: 18;
                margin-top: 18;
                margin-bottom: 24;
                margin-start: 24;
                margin-end: 24;

                Box disk_box {
                  orientation: vertical;
                  spacing: 8;

                  Label {
                    label: _("Disk Space");
                    xalign: 0;

                    styles [
                      "heading",
                    ]
                  }

                  Box {
                    orientation: vertical;
                    spacing: 10;

                    styles [
                      "card",
                      "info-card",
                    ]

                    $PigouneStackedBar disk_bar {}

                    Adw.WrapBox disk_legend {
                      child-spacing: 14;
                      line-spacing: 4;
                    }
                  }
                }

                ListBox {
                  selection-mode: none;

                  styles [
                    "boxed-list",
                  ]

                  Adw.ActionRow location_row {
                    title: _("Location");
                    subtitle-selectable: true;

                    [suffix]
                    Button {
                      icon-name: "edit-copy-symbolic";
                      tooltip-text: _("Copy the Location");
                      valign: center;
                      clicked => $on_copy_location_clicked() swapped;

                      styles [
                        "flat",
                      ]
                    }

                    [suffix]
                    Button {
                      icon-name: "folder-open-symbolic";
                      tooltip-text: _("Open the Folder");
                      valign: center;
                      clicked => $on_open_folder_clicked() swapped;

                      styles [
                        "flat",
                      ]
                    }
                  }

                  Adw.ActionRow disk_row {
                    title: _("Disk");
                  }

                  Adw.ActionRow thumbnails_row {
                    title: _("Thumbnails");
                    tooltip-text: _(
                      "Thumbnails are small copies of the images that keep the grid fast. Clearing them is safe: they are made again when needed."
                    );

                    [suffix]
                    Button thumbnails_button {
                      label: _("_Clear");
                      use-underline: true;
                      valign: center;
                      clicked => $on_clear_thumbnails_clicked() swapped;
                    }
                  }

                  Adw.ActionRow created_row {
                    title: _("Created");
                  }

                  Adw.ActionRow format_row {
                    title: _("Compatibility");

                    [suffix]
                    Image {
                      icon-name: "object-select-symbolic";
                      valign: center;

                      styles [
                        "success",
                      ]
                    }
                  }
                }
              };
            };
          };
        }

        Adw.ViewStackPage {
          name: "health";
          title: _("Health");
          icon-name: "security-high-symbolic";

          child: $PigouneHealthPage health_page {};
        }

        Adw.ViewStackPage {
          name: "export";
          title: _("Export");
          icon-name: "document-send-symbolic";

          child: ScrolledWindow {
            hscrollbar-policy: never;
            propagate-natural-height: true;

            child: Adw.StatusPage {
              icon-name: "folder-symbolic";
              title: _("Export the Library");
              description: _("Pigoune copies your files into an ordinary folder, arranged like your collections. Nothing in the library is modified.");

              styles [
                "compact",
              ]

              child: Adw.Clamp {
                maximum-size: 440;
                tightening-threshold: 380;

                child: Box {
                  orientation: vertical;
                  spacing: 18;

                  ListBox {
                    selection-mode: none;

                    styles [
                      "boxed-list",
                    ]

                    ListBoxRow {
                      activatable: false;
                      selectable: false;

                      child: Box export_tree {
                        orientation: vertical;
                        spacing: 4;
                        margin-top: 12;
                        margin-bottom: 12;
                        margin-start: 14;
                        margin-end: 14;
                      };
                    }
                  }

                  Button export_button {
                    label: _("_Export…");
                    use-underline: true;
                    halign: center;
                    clicked => $on_export_clicked() swapped;

                    styles [
                      "pill",
                      "suggested-action",
                    ]
                  }

                  Label {
                    label: _("Tags, notes and favorites stay in Pigoune. This is not a full backup: for that, copy the library folder.");
                    wrap: true;
                    max-width-chars: 50;
                    justify: center;

                    styles [
                      "dim-label",
                    ]
                  }
                };
              };
            };
          };
        }
      };
    };
  };
}

Adw.WindowTitle window_title {
  title: _("Manage Library");
}
