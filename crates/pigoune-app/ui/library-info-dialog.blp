using Gtk 4.0;
using Adw 1;

template $PigouneLibraryInfoDialog: Adw.Dialog {
  title: _("Library Information");
  follows-content-size: true;

  child: Adw.ToolbarView {
    width-request: 520;

    [top]
    Adw.HeaderBar {}

    content: Adw.ToastOverlay toast_overlay {
      child: ScrolledWindow {
        hscrollbar-policy: never;
        propagate-natural-height: true;

        child: Box {
          orientation: vertical;
          spacing: 24;
          margin-top: 12;
          margin-bottom: 24;
          margin-start: 24;
          margin-end: 24;

          Label name_label {
            wrap: true;
            justify: center;

            styles [
              "title-1",
            ]
          }

          Grid figures_grid {
            column-homogeneous: true;
            column-spacing: 12;
            row-spacing: 12;
          }

          Box chart_box {
            orientation: vertical;
            spacing: 18;

            Box {
              spacing: 24;
              halign: center;

              Overlay {
                valign: center;

                child: $PigouneRingChart ring_chart {};

                [overlay]
                Box {
                  orientation: vertical;
                  halign: center;
                  valign: center;

                  Label total_label {
                    styles [
                      "title-3",
                      "numeric",
                    ]
                  }

                  Label total_caption {
                    styles [
                      "caption",
                      "dim-label",
                    ]
                  }
                }
              }

              Grid legend_grid {
                valign: center;
                column-spacing: 12;
                row-spacing: 6;
              }
            }

            Adw.ToggleGroup measure_toggles {
              halign: center;
              active-name: "weight";
              notify::active-name => $on_measure_changed() swapped;

              Adw.Toggle {
                name: "weight";
                label: _("Size");
              }

              Adw.Toggle {
                name: "count";
                label: _("Number");
              }
            }

            Label storage_label {
              wrap: true;
              justify: center;

              styles [
                "caption",
                "dim-label",
              ]
            }
          }

          Box records_box {
            orientation: vertical;
            spacing: 6;

            Label {
              label: _("Records");
              xalign: 0;

              styles [
                "heading",
              ]
            }

            ListBox records_list {
              selection-mode: none;
              row-activated => $on_record_activated() swapped;

              styles [
                "boxed-list",
              ]
            }
          }

          Box disk_box {
            orientation: vertical;
            spacing: 6;

            Label {
              label: _("Disk Space");
              xalign: 0;

              styles [
                "heading",
              ]
            }

            $PigouneStackedBar disk_bar {}

            Label disk_label {
              xalign: 0;
              wrap: true;
              use-markup: true;

              styles [
                "caption",
              ]
            }
          }

          ListBox {
            selection-mode: none;

            styles [
              "boxed-list",
            ]

            Adw.ActionRow location_row {
              title: _("Location");
              subtitle-selectable: true;

              [suffix]
              Button {
                icon-name: "edit-copy-symbolic";
                tooltip-text: _("Copy the Location");
                valign: center;
                clicked => $on_copy_location_clicked() swapped;

                styles [
                  "flat",
                ]
              }

              [suffix]
              Button {
                icon-name: "folder-open-symbolic";
                tooltip-text: _("Open the Folder");
                valign: center;
                clicked => $on_open_folder_clicked() swapped;

                styles [
                  "flat",
                ]
              }
            }

            Adw.ActionRow disk_row {
              title: _("Disk");
            }

            Adw.ActionRow created_row {
              title: _("Created");
            }

            Adw.ActionRow format_row {
              title: _("Compatibility");

              [suffix]
              Image {
                icon-name: "object-select-symbolic";
                valign: center;

                styles [
                  "success",
                ]
              }
            }
          }
        };
      };
    };
  };
}
