using Gtk 4.0;
using Adw 1;

Adw.PreferencesDialog dialog {
  search-enabled: true;

  Adw.PreferencesPage general_page {
    title: _("General");
    icon-name: "emblem-system-symbolic";

    Adw.PreferencesGroup {
      title: _("Language");

      Adw.ComboRow language_row {
        title: _("Interface Language");
        subtitle: _("Applies the next time Pigoune starts");
      }
    }

    Adw.PreferencesGroup {
      title: _("Opening");

      Adw.SwitchRow reopen_last_library_row {
        title: _("Reopen the Last Library");
        subtitle: _("At startup");
      }

      Adw.SpinRow recent_libraries_row {
        title: _("Recent Libraries");
        subtitle: _("Offered in the menu and on the welcome page, 0 to hide them");

        adjustment: Adjustment {
          lower: 0;
          upper: 8;
          step-increment: 1;
          page-increment: 1;
        };
      }

      Adw.SwitchRow restore_last_view_row {
        title: _("Reopen the Last Entry");
        subtitle: _("Instead of All");
      }

      Adw.SwitchRow show_whats_new_row {
        title: _("Show What’s New After an Update");
        subtitle: _("A window at the first start of a new version");
      }
    }

    Adw.PreferencesGroup {
      title: _("Trash");

      Adw.SwitchRow confirm_empty_trash_row {
        title: _("Confirm Before Emptying the Trash");
        subtitle: _("A question is asked before resources are deleted for good");
      }

      Adw.SwitchRow auto_empty_trash_row {
        title: _("Empty the Trash Automatically");
        subtitle: _("After 30 days");
      }
    }
  }

  Adw.PreferencesPage display_page {
    title: _("Display");
    icon-name: "view-grid-symbolic";

    Adw.PreferencesGroup {
      title: _("Grid");

      Adw.SwitchRow show_names_row {
        title: _("Show Resource Names");
        subtitle: _("Under each thumbnail");
      }

      Adw.SwitchRow show_formats_row {
        title: _("Show Formats");
        subtitle: _("A badge such as SVG or PNG on each thumbnail");
      }

      Adw.ComboRow tile_background_row {
        title: _("Thumbnail Background");
        subtitle: _("Helps to see white or black images");

        model: StringList {
          strings [
            _("Default"),
            _("White"),
            _("Gray"),
            _("Black"),
            _("Checkerboard"),
          ]
        };
      }

      Adw.SwitchRow animate_on_hover_row {
        title: _("Play Animations on Hover");
        subtitle: _("Animated images move when the pointer is over them");
      }
    }

    Adw.PreferencesGroup {
      title: _("Sidebar");

      Adw.SwitchRow show_counts_row {
        title: _("Show Resource Counts");
        subtitle: _("Next to each entry of the sidebar");
      }

      Adw.SwitchRow show_tags_row {
        title: _("Show Tags");
        subtitle: _("A section to open each tag in one click");
      }

      Adw.SwitchRow show_smart_collections_row {
        title: _("Show Smart Collections");
        subtitle: _("A section for the collections that fill themselves");
      }
    }
  }

  Adw.PreferencesPage behaviour_page {
    title: _("Behavior");
    icon-name: "input-mouse-symbolic";

    Adw.PreferencesGroup {
      title: _("Resources");

      Adw.SwitchRow double_click_opens_row {
        title: _("Open Resources on Double-Click");
        subtitle: _("In the default application instead of the preview");
      }
    }

    Adw.PreferencesGroup {
      title: C_("preferences group", "Search");

      Adw.SwitchRow search_everywhere_row {
        title: _("Search the Whole Library");
        subtitle: _("Except in the trash and smart collections");
      }
    }
  }
}
