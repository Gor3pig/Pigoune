using Gtk 4.0;
using Adw 1;

Adw.PreferencesDialog dialog {
  Adw.PreferencesPage page {
    Adw.PreferencesGroup {
      title: _("Opening");

      Adw.SwitchRow reopen_last_library_row {
        title: _("Reopen the Last Library");
        subtitle: _("At startup, the library left open last time opens again");
      }

      Adw.SpinRow recent_libraries_row {
        title: _("Recent Libraries");
        subtitle: _("How many libraries the menu and the welcome page offer, 0 to turn them off");

        adjustment: Adjustment {
          lower: 0;
          upper: 8;
          step-increment: 1;
          page-increment: 1;
        };
      }

      Adw.SwitchRow restore_last_view_row {
        title: _("Reopen the Last Entry");
        subtitle: _("A library opens on the entry selected last time instead of All");
      }
    }

    Adw.PreferencesGroup {
      title: _("Grid");

      Adw.SwitchRow show_names_row {
        title: _("Show Resource Names");
        subtitle: _("The name of each resource appears under its thumbnail");
      }

      Adw.SwitchRow animate_on_hover_row {
        title: _("Play Animations on Hover");
        subtitle: _("Animated thumbnails play when the pointer is over them");
      }

      Adw.SwitchRow show_formats_row {
        title: _("Show Formats");
        subtitle: _("A badge shows the format of each resource on its thumbnail");
      }

      Adw.ComboRow tile_background_row {
        title: _("Thumbnail Background");
        subtitle: _("A plain background helps to see white or black images");

        model: StringList {
          strings [
            _("Default"),
            _("White"),
            _("Gray"),
            _("Black"),
            _("Checkerboard"),
          ]
        };
      }

      Adw.SwitchRow double_click_opens_row {
        title: _("Open Resources on Double-Click");
        subtitle: _("A double-click opens the resource in its default application instead of the preview");
      }
    }

    Adw.PreferencesGroup {
      title: C_("preferences group", "Search");

      Adw.SwitchRow search_everywhere_row {
        title: _("Search the Whole Library");
        subtitle: _("Searches and filters look everywhere, except in the trash and smart collections");
      }
    }

    Adw.PreferencesGroup {
      title: _("Sidebar");

      Adw.SwitchRow show_counts_row {
        title: _("Show Resource Counts");
        subtitle: _("The number of resources appears next to each entry");
      }

      Adw.SwitchRow show_tags_row {
        title: _("Show Tags");
        subtitle: _("Each tag appears in the sidebar to show its resources in one click");
      }

      Adw.SwitchRow show_smart_collections_row {
        title: _("Show Smart Collections");
        subtitle: _("Each smart collection appears in the sidebar, filled with the resources matching its criteria");
      }
    }

    Adw.PreferencesGroup storage_group {
      title: _("Storage");
      visible: false;

      Adw.ActionRow thumbnails_row {
        title: _("Thumbnails");

        [suffix]
        Button clear_thumbnails_button {
          label: _("_Clear");
          use-underline: true;
          valign: center;
        }
      }
    }

    Adw.PreferencesGroup {
      title: _("Trash");

      Adw.SwitchRow confirm_empty_trash_row {
        title: _("Confirm Before Emptying the Trash");
        subtitle: _("A confirmation is asked before resources are deleted for good");
      }

      Adw.SwitchRow auto_empty_trash_row {
        title: _("Empty the Trash Automatically");
        subtitle: _("Resources are deleted for good after 30 days in the trash");
      }
    }
  }
}
