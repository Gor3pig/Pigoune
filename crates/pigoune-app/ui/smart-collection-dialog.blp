using Gtk 4.0;
using Adw 1;

template $PigouneSmartCollectionDialog: Adw.Dialog {
  content-width: 440;
  default-widget: confirm_button;
  focus-widget: name_row;

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      show-start-title-buttons: false;
      show-end-title-buttons: false;

      [start]
      Button {
        label: _("_Cancel");
        use-underline: true;
        clicked => $on_cancel_clicked() swapped;
      }

      [end]
      Button confirm_button {
        use-underline: true;
        clicked => $on_confirm_clicked() swapped;

        styles [
          "suggested-action",
        ]
      }
    }

    content: ScrolledWindow {
      hscrollbar-policy: never;
      propagate-natural-height: true;
      max-content-height: 520;

      child: Box {
        orientation: vertical;
        spacing: 18;
        margin-top: 12;
        margin-bottom: 24;
        margin-start: 12;
        margin-end: 12;

        ListBox {
          selection-mode: none;

          styles [
            "boxed-list",
          ]

          Adw.EntryRow name_row {
            title: _("Name");
            activates-default: true;
            changed => $on_changed() swapped;
          }
        }

        Box {
          orientation: vertical;
          spacing: 6;

          Adw.PreferencesGroup {
            title: _("Shows the Resources");

            Adw.EntryRow text_row {
              title: _("Words to Find");
              activates-default: true;
              changed => $on_changed() swapped;
            }
          }

          $PigouneQueryPills text_pills {}

          Label search_help {
            wrap: true;
            xalign: 0;
            margin-start: 6;
            margin-end: 6;

            styles [
              "dim-label",
              "caption",
            ]
          }
        }

        Adw.PreferencesGroup {
          title: _("Filters");

          Adw.Bin {
            styles [
              "card",
            ]

            child: $PigouneFilterChoices choices {
              margin-top: 12;
              margin-bottom: 12;
              margin-start: 12;
              margin-end: 12;
            };
          }
        }

        Label hint_label {
          label: _("Choose at least one criterion: words to find, a type, a shape, fitting the screen, a color or favorites only.");
          wrap: true;
          xalign: 0;
          margin-start: 6;
          margin-end: 6;

          styles [
            "dim-label",
          ]
        }

        Label error_label {
          visible: false;
          wrap: true;
          xalign: 0;
          margin-start: 6;
          margin-end: 6;

          styles [
            "error",
          ]
        }
      };
    };
  };
}
