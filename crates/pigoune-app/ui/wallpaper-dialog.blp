using Gtk 4.0;
using Adw 1;

template $PigouneWallpaperDialog: Adw.Dialog {
  title: _("Frame the Wallpaper");
  content-width: 1100;
  content-height: 720;
  width-request: 360;
  height-request: 400;
  default-widget: set_button;

  Adw.Breakpoint {
    condition ("max-width: 720sp")

    setters {
      content_box.orientation: vertical;
      stage_overlay.height-request: 220;
      panel.propagate-natural-height: true;
      window_title.visible: false;
      full_screen_button.visible: false;
      foot_box.orientation: vertical;
      hint_label.xalign: 0;
    }
  }

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      show-start-title-buttons: false;
      show-end-title-buttons: false;

      title-widget: Adw.WindowTitle window_title {
        title: _("Frame the Wallpaper");
      };

      [start]
      Button {
        label: _("_Cancel");
        use-underline: true;
        clicked => $on_cancel_clicked() swapped;
      }

      [end]
      Button set_button {
        sensitive: false;
        clicked => $on_set_clicked() swapped;

        child: Label {
          label: _("_Set as Wallpaper");
          use-underline: true;
          ellipsize: end;
        };

        styles [
          "suggested-action",
        ]
      }

      [end]
      Button full_screen_button {
        icon-name: "view-fullscreen-symbolic";
        tooltip-text: _("Full Screen");
        clicked => $on_full_screen_clicked() swapped;
      }
    }

    content: ScrolledWindow {
      hscrollbar-policy: never;
      vexpand: true;

      child: Box content_box {
        Box {
          orientation: vertical;
          hexpand: true;

          Overlay stage_overlay {
            vexpand: true;
            child: $PigouneWallpaperStage stage {};

          }

          Box {
            orientation: vertical;
            spacing: 12;
            margin-top: 12;
            margin-bottom: 12;
            margin-start: 12;
            margin-end: 12;

            Box {
              spacing: 6;

              Button {
                icon-name: "zoom-out-symbolic";
                tooltip-text: _("Zoom Out");
                valign: center;
                clicked => $on_zoom_out_clicked() swapped;

                styles [
                  "flat",
                  "circular",
                ]
              }

              Scale zoom_scale {
                hexpand: true;
                tooltip-text: _("Zoom");
                draw-value: false;
                value-changed => $on_zoom_scale_changed() swapped;

                adjustment: Adjustment {
                  lower: -4.605;
                  upper: 2.08;
                  step-increment: 0.05;
                  page-increment: 0.2;
                };
              }

              Button {
                icon-name: "zoom-in-symbolic";
                tooltip-text: _("Zoom In");
                valign: center;
                clicked => $on_zoom_in_clicked() swapped;

                styles [
                  "flat",
                  "circular",
                ]
              }

              Label zoom_label {
                tooltip-text: _("100%: one pixel of the image for one pixel of the screen");
                width-chars: 6;
                xalign: 1;

                styles [
                  "numeric",
                ]
              }
            }

            Box {
              homogeneous: true;

              Button {
                label: _("Fill");
                tooltip-text: _("Covers the whole screen, as the desktop does; the edges that go past it are cut");
                clicked => $on_fill_clicked() swapped;
              }

              Button {
                label: _("Whole");
                tooltip-text: _("Shows the whole image; the rest of the screen is filled as chosen under Empty Space");
                clicked => $on_whole_clicked() swapped;
              }

              Button actual_button {
                tooltip-text: _("One pixel of the image for one pixel of the screen, for the sharpest result");
                clicked => $on_actual_clicked() swapped;
              }

              styles [
                "linked",
              ]
            }

            Box {
              homogeneous: true;
              spacing: 6;

              ToggleButton mirror_button {
                label: _("Mirror");
                tooltip-text: _("Flips the image from left to right, in the wallpaper only");
                toggled => $on_mirror_toggled() swapped;
              }

              ToggleButton thirds_button {
                label: _("Thirds");
                tooltip-text: _("Shows the rule of thirds grid, to place the subject");
                toggled => $on_thirds_toggled() swapped;
              }

              ToggleButton snap_button {
                label: _("Snap");
                tooltip-text: _("While dragging, the image snaps to the center and the edges of the screen");
                active: true;
                toggled => $on_snap_toggled() swapped;
              }
            }

            Box legend_box {
              spacing: 6;
              visible: false;

              Image legend_icon {
                icon-name: "dialog-warning-symbolic";
                valign: start;
                visible: false;

                styles [
                  "warning",
                ]
              }

              Label legend_label {
                xalign: 0;
                wrap: true;
                hexpand: true;

                styles [
                  "caption",
                ]
              }
            }

            Adw.PreferencesGroup screen_group {
              title: _("Screen");
            }
          }
        }

        Separator {}

        ScrolledWindow panel {
          hscrollbar-policy: never;
          hexpand: false;
          width-request: 340;

          child: Box {
            orientation: vertical;
            spacing: 18;
            margin-top: 12;
            margin-bottom: 12;
            margin-start: 12;
            margin-end: 12;

          Box {
            orientation: vertical;
            spacing: 6;

            Label {
              label: _("Empty Space");
              xalign: 0;

              styles [
                "heading",
              ]
            }

            Label {
              label: _("Visible when the image does not cover the whole screen");
              xalign: 0;
              wrap: true;

              styles [
                "dim-label",
              ]
            }

            Adw.ToggleGroup backdrop_toggles {
              active-name: "color";
              margin-top: 6;
              notify::active-name => $on_backdrop_changed() swapped;

              Adw.Toggle {
                name: "color";
                label: _("Color");
              }

              Adw.Toggle {
                name: "gradient";
                label: _("Gradient");
              }

              Adw.Toggle {
                name: "blur";
                label: _("Blur");
              }

              Adw.Toggle {
                name: "mosaic";
                label: _("Mosaic");
              }
            }

            Box swatches_box {
              orientation: vertical;
              spacing: 6;
              margin-top: 6;

              Label swatches_hint {
                xalign: 0;
                wrap: true;

                styles [
                  "dim-label",
                  "caption",
                ]
              }
            }

            Box gradient_box {
              orientation: vertical;
              spacing: 6;
              margin-top: 6;
              visible: false;

              Box {
                spacing: 6;

                Label {
                  label: _("Angle");
                }

                Scale angle_scale {
                  hexpand: true;
                  draw-value: false;
                  tooltip-text: _("Direction of the gradient: 0° goes up, 90° to the right, 180° down");
                  value-changed => $on_gradient_color_changed() swapped;

                  adjustment: Adjustment {
                    lower: 0;
                    upper: 360;
                    step-increment: 1;
                    page-increment: 45;
                    value: 180;
                  };
                }

                Label angle_label {
                  width-chars: 4;
                  xalign: 1;

                  styles [
                    "numeric",
                  ]
                }
              }

              ListBox {
                selection-mode: none;

                styles [
                  "boxed-list",
                ]

                Adw.ActionRow {
                  title: _("Start Color");
                  activatable-widget: top_button;

                  [suffix]
                  ColorDialogButton top_button {
                    valign: center;
                    tooltip-text: _("Choose the start color");
                    notify::rgba => $on_gradient_color_changed() swapped;

                    dialog: ColorDialog {
                      with-alpha: false;
                    };
                  }
                }

                Adw.ActionRow {
                  title: _("End Color");
                  activatable-widget: bottom_button;

                  [suffix]
                  ColorDialogButton bottom_button {
                    valign: center;
                    tooltip-text: _("Choose the end color");
                    notify::rgba => $on_gradient_color_changed() swapped;

                    dialog: ColorDialog {
                      with-alpha: false;
                    };
                  }
                }
              }

              Button {
                halign: end;
                clicked => $on_swap_clicked() swapped;

                child: Adw.ButtonContent {
                  icon-name: "object-flip-vertical-symbolic";
                  label: _("Swap Colors");
                };

                styles [
                  "flat",
                ]
              }
            }
          }

          Adw.PreferencesGroup {
            title: _("Image");

            Box {
              spacing: 6;

              Label {
                label: _("Darken");
              }

              Scale darkness_scale {
                hexpand: true;
                draw-value: false;
                tooltip-text: _("Darkens the whole wallpaper so that icons and bars stay readable");
                value-changed => $on_darkness_changed() swapped;

                adjustment: Adjustment {
                  lower: 0;
                  upper: 60;
                  step-increment: 1;
                  page-increment: 10;
                };
              }

              Label darkness_label {
                width-chars: 5;
                xalign: 1;

                styles [
                  "numeric",
                ]
              }
            }
          }

          Adw.PreferencesGroup {
            title: _("Simulation");

            Adw.SwitchRow bar_row {
              title: _("Desktop Simulation");
              subtitle: _("Shows the bars of your desktop over the image, to judge the framing. They are not part of the wallpaper.");
              active: true;
              notify::active => $on_bar_changed() swapped;
            }

            Adw.ComboRow desktop_row {
              title: _("Desktop");
              visible: bind bar_row.active;
              notify::selected => $on_desktop_changed() swapped;
            }
          }
          };
        }
      };
    };

    [bottom]
    Box foot_box {
      spacing: 12;
      margin-top: 6;
      margin-bottom: 6;
      margin-start: 12;
      margin-end: 12;

      CheckButton add_check {
        tooltip-text: _("The framed image, at the size of the screen, becomes a new resource. The original image stays untouched.");

        child: Label {
          label: _("Also Add the Edited Version to the Library");
          wrap: true;
          xalign: 0;
        };
      }

      Label hint_label {
        hexpand: true;
        xalign: 1;
        wrap: true;

        styles [
          "dim-label",
          "caption",
        ]
      }
    }
  };
}
