using Gtk 4.0;
using Adw 1;

template $PigouneWallpaperDialog: Adw.Dialog {
  title: _("Frame the Wallpaper");
  content-width: 1100;
  content-height: 720;
  width-request: 360;
  height-request: 400;
  default-widget: set_button;

  Adw.Breakpoint {
    condition ("max-width: 720sp")

    setters {
      content_box.orientation: vertical;
    }
  }

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      show-start-title-buttons: false;
      show-end-title-buttons: false;

      title-widget: Adw.WindowTitle window_title {
        title: _("Frame the Wallpaper");
      };

      [start]
      Button {
        label: _("_Cancel");
        use-underline: true;
        clicked => $on_cancel_clicked() swapped;
      }

      [end]
      Button set_button {
        label: _("_Set as Wallpaper");
        use-underline: true;
        sensitive: false;
        clicked => $on_set_clicked() swapped;

        styles [
          "suggested-action",
        ]
      }

      [end]
      Button {
        icon-name: "view-fullscreen-symbolic";
        tooltip-text: _("Full Screen");
        clicked => $on_full_screen_clicked() swapped;
      }
    }

    content: Box content_box {
      Overlay {
        child: $PigouneWallpaperStage stage {};

        [overlay]
        Revealer sharpness_revealer {
          halign: center;
          valign: start;
          margin-top: 12;
          margin-start: 12;
          margin-end: 12;
          transition-type: crossfade;
          can-target: false;

          child: Box {
            spacing: 8;

            Image {
              icon-name: "dialog-warning-symbolic";
            }

            Label sharpness_label {
              wrap: true;
            }

            styles [
              "osd",
              "wallpaper-notice",
            ]
          };
        }
      }

      Separator {}

      ScrolledWindow {
        hscrollbar-policy: never;
        propagate-natural-height: true;
        hexpand: false;
        width-request: 300;

        child: Box {
          orientation: vertical;
          spacing: 18;
          margin-top: 12;
          margin-bottom: 12;
          margin-start: 12;
          margin-end: 12;

          Adw.PreferencesGroup screen_group {
            title: _("Screen");
          }

          Adw.PreferencesGroup {
            title: _("Framing");

            Box {
              orientation: vertical;
              spacing: 12;

              Box {
                spacing: 6;

                Button {
                  icon-name: "zoom-out-symbolic";
                  tooltip-text: _("Zoom Out");
                  valign: center;
                  clicked => $on_zoom_out_clicked() swapped;

                  styles [
                    "flat",
                    "circular",
                  ]
                }

                Scale zoom_scale {
                  hexpand: true;
                  tooltip-text: _("Zoom");
                  draw-value: false;
                  value-changed => $on_zoom_scale_changed() swapped;

                  adjustment: Adjustment {
                    lower: -4.605;
                    upper: 2.08;
                    step-increment: 0.05;
                    page-increment: 0.2;
                  };
                }

                Button {
                  icon-name: "zoom-in-symbolic";
                  tooltip-text: _("Zoom In");
                  valign: center;
                  clicked => $on_zoom_in_clicked() swapped;

                  styles [
                    "flat",
                    "circular",
                  ]
                }

                Label zoom_label {
                  tooltip-text: _("100%: one pixel of the image for one pixel of the screen");
                  width-chars: 6;
                  xalign: 1;

                  styles [
                    "numeric",
                  ]
                }
              }

              Box {
                homogeneous: true;

                Button {
                  label: _("Fill");
                  tooltip-text: _("Covers the whole screen, as the desktop does; the edges that go past it are cut");
                  clicked => $on_fill_clicked() swapped;
                }

                Button {
                  label: _("Whole");
                  tooltip-text: _("Shows the whole image; the rest of the screen is filled as chosen under Empty Space");
                  clicked => $on_whole_clicked() swapped;
                }

                Button actual_button {
                  tooltip-text: _("One pixel of the image for one pixel of the screen, for the sharpest result");
                  clicked => $on_actual_clicked() swapped;
                }

                styles [
                  "linked",
                ]
              }
            }
          }

          Box {
            orientation: vertical;
            spacing: 6;

            Label {
              label: _("Empty Space");
              xalign: 0;

              styles [
                "heading",
              ]
            }

            Label {
              label: _("Visible when the image does not cover the whole screen");
              xalign: 0;
              wrap: true;

              styles [
                "dim-label",
              ]
            }

            Adw.ToggleGroup backdrop_toggles {
              active-name: "color";
              homogeneous: true;
              margin-top: 6;
              notify::active-name => $on_backdrop_changed() swapped;

              Adw.Toggle {
                name: "color";
                label: _("Color");
              }

              Adw.Toggle {
                name: "blur";
                label: _("Blur");
              }
            }

            ListBox color_list {
              selection-mode: none;
              margin-top: 6;

              styles [
                "boxed-list",
              ]

              Adw.ActionRow {
                title: _("Background Color");
                activatable-widget: color_button;

                [suffix]
                ColorDialogButton color_button {
                  valign: center;
                  notify::rgba => $on_backdrop_changed() swapped;

                  dialog: ColorDialog {
                    with-alpha: false;
                  };
                }
              }
            }
          }

          Adw.PreferencesGroup {
            title: _("Simulation");

            Adw.SwitchRow bar_row {
              title: _("Desktop Simulation");
              subtitle: _("Shows the bars of your desktop over the image, to judge the framing. They are not part of the wallpaper.");
              active: true;
              notify::active => $on_bar_changed() swapped;
            }

            Adw.ComboRow desktop_row {
              title: _("Desktop");
              visible: bind bar_row.active;
              notify::selected => $on_desktop_changed() swapped;
            }
          }
        };
      }
    };

    [bottom]
    Box {
      spacing: 12;
      margin-top: 6;
      margin-bottom: 6;
      margin-start: 12;
      margin-end: 12;

      CheckButton add_check {
        label: _("Also Add the Edited Version to the Library");
        tooltip-text: _("The framed image, at the size of the screen, becomes a new resource. The original image stays untouched.");
      }

      Label hint_label {
        hexpand: true;
        xalign: 1;
        wrap: true;

        styles [
          "dim-label",
          "caption",
        ]
      }
    }
  };
}
