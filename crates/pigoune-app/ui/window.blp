using Gtk 4.0;
using Adw 1;

template $PigouneWindow: Adw.ApplicationWindow {
  title: "Pigoune";
  width-request: 440;
  height-request: 294;

  Adw.Breakpoint {
    condition ("max-width: 1040sp")

    setters {
      details_split.collapsed: true;
      grid_header.compact: true;
    }
  }

  Adw.Breakpoint {
    condition ("max-width: 760sp")

    setters {
      details_split.collapsed: true;
      sidebar_split.collapsed: true;
      grid_header.compact: true;
      grid_header.narrow: true;
    }
  }

  content: Stack window_stack {
    transition-type: crossfade;
    hhomogeneous: false;

    StackPage {
      name: "main";

      child: Adw.ToastOverlay toast_overlay {
        child: Gtk.Stack stack {
          transition-type: crossfade;
          hhomogeneous: false;

          StackPage {
            name: "welcome";

            child: Adw.ToolbarView {
              [top]
              Adw.HeaderBar {
                [end]
                MenuButton {
                  primary: true;
                  icon-name: "open-menu-symbolic";
                  tooltip-text: _("Main Menu");
                  menu-model: primary_menu;
                }
              }

              content: Adw.StatusPage {
                icon-name: "io.github.gor3pig.Pigoune";
                title: _("Welcome to Pigoune");
                description: _("All your graphic assets, organized and within reach.");

                styles [
                  "icon-dropshadow",
                ]

                child: Box {
                  orientation: vertical;
                  spacing: 12;
                  halign: center;

                  Button {
                    label: _("_Create a Library");
                    use-underline: true;
                    action-name: "win.create-library";

                    styles [
                      "pill",
                      "suggested-action",
                    ]
                  }

                  Button {
                    label: _("_Open a Library");
                    use-underline: true;
                    action-name: "win.open-library";

                    styles [
                      "pill",
                    ]
                  }
                };
              };
            };
          }

          StackPage {
            name: "library";

            child: Adw.OverlaySplitView sidebar_split {
              min-sidebar-width: 200;
              max-sidebar-width: 280;

              sidebar: Adw.ToolbarView {
                [top]
                Adw.HeaderBar {
                  title-widget: Adw.WindowTitle window_title {
                    title: "Pigoune";
                  };

                  [start]
                  MenuButton import_button {
                    icon-name: "list-add-symbolic";
                    tooltip-text: _("Import");
                    menu-model: import_menu;
                  }

                  [end]
                  MenuButton {
                    primary: true;
                    icon-name: "open-menu-symbolic";
                    tooltip-text: _("Main Menu");
                    menu-model: primary_menu;
                  }
                }

                content: $PigouneSidebar sidebar {};
              };

              content: Adw.OverlaySplitView details_split {
                sidebar-position: end;
                min-sidebar-width: 280;
                max-sidebar-width: 360;

                content: Adw.ToolbarView {
                  [top]
                  $PigouneGridHeader grid_header {}

                  content: Overlay drop_area {
                    [overlay]
                    Adw.StatusPage drop_hint {
                      visible: false;
                      can-target: false;
                      icon-name: "insert-image-symbolic";
                      description: _("Images are copied into the library. The originals are not modified.");

                      styles [
                        "drop-hint",
                      ]
                    }

                    child: Gtk.Stack library_stack {
                      StackPage {
                        name: "empty";

                        child: Adw.StatusPage {
                          icon-name: "folder-pictures-symbolic";
                          title: _("Your Library Is Empty");
                          description: _("Imported icons, logos and illustrations will appear here.");

                          child: Box {
                            orientation: vertical;
                            spacing: 12;
                            halign: center;

                            Button {
                              label: _("Import _Files…");
                              use-underline: true;
                              action-name: "win.import-files";

                              styles [
                                "pill",
                                "suggested-action",
                              ]
                            }

                            Button {
                              label: _("Import a F_older…");
                              use-underline: true;
                              action-name: "win.import-folder";

                              styles [
                                "pill",
                              ]
                            }
                          };
                        };
                      }

                      StackPage {
                        name: "assets";

                        child: Box {
                          orientation: vertical;

                          Adw.Banner trash_banner {
                            title: _("Resources in the trash are deleted for good only when it is emptied.");
                            button-label: _("_Empty Trash…");
                            action-name: "win.empty-trash";
                          }

                          $PigouneAssetGrid asset_grid {
                            vexpand: true;
                          }
                        };
                      }
                    };
                  };
                };

                sidebar: Adw.ToolbarView {
                  [top]
                  Adw.HeaderBar {
                    title-widget: Adw.WindowTitle {
                      title: _("Details");
                    };
                  }

                  content: $PigouneAssetDetails asset_details {};
                };
              };
            };
          }
        };
      };
    }

    StackPage {
      name: "preview";

      child: $PigouneAssetPreview asset_preview {};
    }
  };
}

menu import_menu {
  section {
    item {
      label: _("Import _Files…");
      action: "win.import-files";
    }

    item {
      label: _("Import a F_older…");
      action: "win.import-folder";
    }
  }
}

menu primary_menu {
  section {
    item {
      label: _("_Close Library");
      action: "win.close-library";
    }
  }

  section {
    item {
      label: _("_Preferences");
      action: "win.preferences";
    }

    item {
      label: _("_Keyboard Shortcuts");
      action: "app.shortcuts";
    }

    item {
      label: _("_Help");
      action: "app.help";
    }

    item {
      label: _("_About Pigoune");
      action: "app.about";
    }
  }
}
