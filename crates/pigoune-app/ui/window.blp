using Gtk 4.0;
using Adw 1;

template $PigouneWindow: Adw.ApplicationWindow {
  title: "Pigoune";
  width-request: 360;
  height-request: 294;

  content: Stack window_stack {
    transition-type: crossfade;

    StackPage {
      name: "main";

      child: Adw.ToolbarView {
        [top]
        Adw.HeaderBar {
          title-widget: Adw.WindowTitle window_title {
            title: "Pigoune";
          };

          [end]
          MenuButton {
            primary: true;
            icon-name: "open-menu-symbolic";
            tooltip-text: _("Main Menu");
            menu-model: primary_menu;
          }

          [end]
          ToggleButton details_button {
            visible: false;
            active: true;
            icon-name: "sidebar-show-right-symbolic";
            tooltip-text: _("Show Details");
          }

          [end]
          MenuButton import_button {
            visible: false;
            icon-name: "list-add-symbolic";
            tooltip-text: _("Import");
            menu-model: import_menu;
          }
        }

        content: Overlay {
          child: Adw.ToastOverlay toast_overlay {
            child: Gtk.Stack stack {
              transition-type: crossfade;

              StackPage {
                name: "welcome";

                child: Adw.StatusPage {
                  icon-name: "io.github.gor3pig.Pigoune";
                  title: _("Welcome to Pigoune");
                  description: _("The cozy box for your icons, logos and illustrations.");

                  styles [
                    "icon-dropshadow",
                  ]

                  child: Box {
                    orientation: vertical;
                    spacing: 12;
                    halign: center;

                    Button {
                      label: _("_Create a Library");
                      use-underline: true;
                      action-name: "win.create-library";

                      styles [
                        "pill",
                        "suggested-action",
                      ]
                    }

                    Button {
                      label: _("_Open a Library");
                      use-underline: true;
                      action-name: "win.open-library";

                      styles [
                        "pill",
                      ]
                    }
                  };
                };
              }

              StackPage {
                name: "library";

                child: Adw.OverlaySplitView sidebar_split {
                  min-sidebar-width: 200;
                  max-sidebar-width: 280;

                  sidebar: $PigouneSidebar sidebar {};

                  content: Overlay drop_area {
                    [overlay]
                    Adw.StatusPage drop_hint {
                      visible: false;
                      can-target: false;
                      icon-name: "insert-image-symbolic";
                      description: _("Images are copied into the library. The originals are not modified.");

                      styles [
                        "drop-hint",
                      ]
                    }

                    child: Gtk.Stack library_stack {
                      StackPage {
                        name: "empty";

                        child: Adw.StatusPage {
                          icon-name: "folder-pictures-symbolic";
                          title: _("Your Library Is Empty");
                          description: _("Imported icons, logos and illustrations will appear here.");

                          child: Box {
                            orientation: vertical;
                            spacing: 12;
                            halign: center;

                            Button {
                              label: _("Import _Files…");
                              use-underline: true;
                              action-name: "win.import-files";

                              styles [
                                "pill",
                                "suggested-action",
                              ]
                            }

                            Button {
                              label: _("Import a F_older…");
                              use-underline: true;
                              action-name: "win.import-folder";

                              styles [
                                "pill",
                              ]
                            }
                          };
                        };
                      }

                      StackPage {
                        name: "assets";

                        child: Adw.OverlaySplitView details_split {
                          sidebar-position: end;
                          min-sidebar-width: 280;
                          max-sidebar-width: 360;
                          show-sidebar: bind details_button.active bidirectional;

                          content: $PigouneAssetGrid asset_grid {};

                          sidebar: $PigouneAssetDetails asset_details {};
                        };
                      }

                      StackPage {
                        name: "nothing";

                        child: Adw.StatusPage nothing_page {
                          icon-name: "folder-symbolic";
                        };
                      }
                    };
                  };
                };
              }
            };
          };
        };
      };
    }

    StackPage {
      name: "preview";

      child: $PigouneAssetPreview asset_preview {};
    }
  };
}

menu import_menu {
  section {
    item {
      label: _("Import _Files…");
      action: "win.import-files";
    }

    item {
      label: _("Import a F_older…");
      action: "win.import-folder";
    }
  }
}

menu primary_menu {
  section {
    item {
      label: _("_Close Library");
      action: "win.close-library";
    }
  }

  section {
    item {
      label: _("_About Pigoune");
      action: "app.about";
    }
  }
}
