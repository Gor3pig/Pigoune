<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="pigoune">
  <schema id="io.github.gor3pig.Pigoune" path="/io/github/gor3pig/Pigoune/">
    <key name="last-library-path" type="s">
      <default>""</default>
      <summary>Last opened library</summary>
      <description>Path of the library reopened at startup. Empty when no library was left open.</description>
    </key>
    <key name="window-width" type="i">
      <default>1100</default>
      <summary>Window width</summary>
    </key>
    <key name="window-height" type="i">
      <default>720</default>
      <summary>Window height</summary>
    </key>
    <key name="window-maximized" type="b">
      <default>false</default>
      <summary>Window maximized</summary>
    </key>
    <key name="show-details" type="b">
      <default>true</default>
      <summary>Show the details panel</summary>
      <description>Whether the panel describing the selected resource is shown next to the grid.</description>
    </key>
    <key name="sort-criterion" type="s">
      <choices>
        <choice value="added"/>
        <choice value="name"/>
        <choice value="type"/>
        <choice value="dimensions"/>
        <choice value="size"/>
      </choices>
      <default>"added"</default>
      <summary>Sort criterion</summary>
      <description>How the resources of the library grid are ordered.</description>
    </key>
    <key name="sort-reversed" type="b">
      <default>false</default>
      <summary>Reverse sort order</summary>
      <description>Whether the natural direction of the sort criterion is reversed.</description>
    </key>
    <key name="preview-background" type="s">
      <choices>
        <choice value="transparent"/>
        <choice value="white"/>
        <choice value="grey"/>
        <choice value="black"/>
        <choice value="checkerboard"/>
      </choices>
      <default>"transparent"</default>
      <summary>Preview background</summary>
      <description>Background shown behind the resource in the detailed preview.</description>
    </key>
    <key name="thumbnail-size" type="i">
      <range min="64" max="256"/>
      <default>128</default>
      <summary>Thumbnail size</summary>
      <description>Side of the thumbnails in the library grid, in pixels.</description>
    </key>
  </schema>
</schemalist>
