<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.gor3pig.Pigoune</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name translate="no">Pigoune</name>
  <summary>Organize, find and reuse your graphic assets</summary>
  <description>
    <p>
      All your graphic assets, organized and within reach. Drop your icons, logos and
      illustrations into Pigoune: it keeps a safe copy, helps you organize them and gives
      them back with a simple drag and drop.
    </p>
    <ul>
      <li>Import SVG, PNG, JPG, WebP, GIF and ICO files</li>
      <li>Organize with nested collections, tags and favorites</li>
      <li>Find anything instantly with search and filters</li>
      <li>Reuse assets with drag and drop or the clipboard</li>
      <li>Portable libraries, fully local, original files never touched</li>
    </ul>
  </description>

  <screenshots>
    <screenshot type="default">
      <image type="source" width="2300" height="1540">https://raw.githubusercontent.com/Gor3pig/Pigoune/v1.0.0/data/screenshots/01.png</image>
      <caption>Browse your graphic assets in a thumbnail grid</caption>
    </screenshot>
    <screenshot>
      <image type="source" width="2300" height="1540">https://raw.githubusercontent.com/Gor3pig/Pigoune/v1.0.0/data/screenshots/02.png</image>
      <caption>Narrow down your library with search and filters</caption>
    </screenshot>
    <screenshot>
      <image type="source" width="2300" height="1540">https://raw.githubusercontent.com/Gor3pig/Pigoune/v1.0.0/data/screenshots/03.png</image>
      <caption>Organize several assets at once with tags and collections</caption>
    </screenshot>
    <screenshot>
      <image type="source" width="2300" height="1540">https://raw.githubusercontent.com/Gor3pig/Pigoune/v1.0.0/data/screenshots/04.png</image>
      <caption>See the details of an asset at a glance</caption>
    </screenshot>
    <screenshot>
      <image type="source" width="2300" height="1540">https://raw.githubusercontent.com/Gor3pig/Pigoune/v1.0.0/data/screenshots/05.png</image>
      <caption>Light or dark, Pigoune follows your system style</caption>
    </screenshot>
  </screenshots>

  <developer id="io.github.gor3pig">
    <name translate="no">Gor3pig</name>
  </developer>

  <launchable type="desktop-id">io.github.gor3pig.Pigoune.desktop</launchable>
  <provides>
    <binary>pigoune</binary>
  </provides>

  <url type="homepage">https://github.com/Gor3pig/Pigoune</url>
  <url type="bugtracker">https://github.com/Gor3pig/Pigoune/issues</url>
  <url type="vcs-browser">https://github.com/Gor3pig/Pigoune</url>

  <branding>
    <color type="primary" scheme_preference="light">#a6d4f2</color>
    <color type="primary" scheme_preference="dark">#1d4f7a</color>
  </branding>

  <requires>
    <display_length compare="ge">440</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>touch</control>
  </supports>

  <content_rating type="oars-1.1"/>

  <releases>
    <release version="0.1.0" date="2026-10-01">
      <description>
        <p>First development snapshot.</p>
      </description>
    </release>
  </releases>
</component>
