<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.gor3pig.Pigoune</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name translate="no">Pigoune</name>
  <summary>Organize, find and reuse your graphic assets</summary>
  <description>
    <p>
      All your graphic assets, organized and within reach. Drop your icons, logos and
      illustrations into Pigoune: it keeps a safe copy, helps you organize them and gives
      them back with a simple drag and drop.
    </p>
    <ul>
      <li>Import SVG, PNG, JPEG, WebP, AVIF, JPEG XL, GIF, TIFF, BMP and ICO files</li>
      <li>Organize with nested collections, tags and favorites</li>
      <li>Find anything instantly with search and filters</li>
      <li>Reuse assets with drag and drop or the clipboard</li>
      <li>Convert assets to PNG, JPEG, WebP, AVIF or ICO, at any size</li>
      <li>Portable libraries, fully local, original files never touched</li>
    </ul>
  </description>

  <screenshots>
    <screenshot type="default">
      <image type="source" width="2300" height="1540">https://raw.githubusercontent.com/Gor3pig/Pigoune/v1.5.0/data/screenshots/01.png</image>
      <caption>Browse your graphic assets in a thumbnail grid</caption>
    </screenshot>
    <screenshot>
      <image type="source" width="2300" height="1540">https://raw.githubusercontent.com/Gor3pig/Pigoune/v1.5.0/data/screenshots/02.png</image>
      <caption>Narrow down your library with search and filters</caption>
    </screenshot>
    <screenshot>
      <image type="source" width="2300" height="1540">https://raw.githubusercontent.com/Gor3pig/Pigoune/v1.5.0/data/screenshots/03.png</image>
      <caption>Organize several assets at once with tags and collections</caption>
    </screenshot>
    <screenshot>
      <image type="source" width="2300" height="1540">https://raw.githubusercontent.com/Gor3pig/Pigoune/v1.5.0/data/screenshots/04.png</image>
      <caption>See the details of an asset at a glance</caption>
    </screenshot>
    <screenshot>
      <image type="source" width="2300" height="1540">https://raw.githubusercontent.com/Gor3pig/Pigoune/v1.5.0/data/screenshots/05.png</image>
      <caption>Light or dark, Pigoune follows your system style</caption>
    </screenshot>
  </screenshots>

  <developer id="io.github.gor3pig">
    <name translate="no">Gor3pig</name>
  </developer>

  <launchable type="desktop-id">io.github.gor3pig.Pigoune.desktop</launchable>
  <provides>
    <binary>pigoune</binary>
  </provides>

  <url type="homepage">https://github.com/Gor3pig/Pigoune</url>
  <url type="bugtracker">https://github.com/Gor3pig/Pigoune/issues</url>
  <url type="help">https://github.com/Gor3pig/Pigoune/blob/main/help/en/README.md</url>
  <url type="vcs-browser">https://github.com/Gor3pig/Pigoune</url>

  <branding>
    <color type="primary" scheme_preference="light">#a6d4f2</color>
    <color type="primary" scheme_preference="dark">#1d4f7a</color>
  </branding>

  <requires>
    <display_length compare="ge">440</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>touch</control>
  </supports>

  <content_rating type="oars-1.1"/>

  <releases>
    <release version="1.5.0" date="2026-10-04">
      <description>
        <p>Libraries ready to grow, and their real location shown in Flatpak.</p>
        <ul>
          <li>Assets are now sorted into small subfolders inside a library, so very large libraries stay easy to handle for file managers, backups, sync tools and USB drives.</li>
          <li>The welcome page, the recent libraries and the library information show the real folder of a library instead of a technical path.</li>
          <li>Libraries opened with Pigoune 1.5 can no longer be opened with an older version, so update Pigoune on all your computers.</li>
        </ul>
      </description>
    </release>
    <release version="1.4.0" date="2026-10-04">
      <description>
        <p>A big update, with new formats, conversion and a closer look at your libraries.</p>
        <ul>
          <li>Import AVIF, JPEG XL, TIFF and BMP images, and play animated PNG and WebP images.</li>
          <li>Pause an animation in the preview and step through it frame by frame.</li>
          <li>Export assets converted to PNG, JPEG, WebP, AVIF or ICO, with size, quality, background and multi-size icons.</li>
          <li>See the key figures of a library, a chart of the space used by each format, its disk space and its records.</li>
          <li>Reopen recent libraries from the main menu or the welcome page.</li>
          <li>Choose whether to reopen the last library, play animations on hover and how many recent libraries to keep, and clear the thumbnails.</li>
          <li>Libraries opened with Pigoune 1.4 can no longer be opened with an older version, so update Pigoune on all your computers.</li>
        </ul>
      </description>
    </release>
    <release version="1.3.0" date="2026-10-04">
      <description>
        <p>Take a much closer look at your assets in the detailed preview.</p>
        <ul>
          <li>Move between assets with on-screen arrows, a two-finger swipe, Home and End.</li>
          <li>See the format, dimensions and size of the shown asset.</li>
          <li>Drag the image freely, zoom with new buttons, and fill the screen with F11.</li>
          <li>Spot the real edges of an image and, from 800%, every single pixel.</li>
          <li>Star, copy, export or open the shown asset without leaving the preview.</li>
          <li>Switch between the sizes stored in an ICO file.</li>
          <li>Open any asset in another application with Open With.</li>
          <li>Grab the window more easily by the middle of the library header.</li>
        </ul>
      </description>
    </release>
    <release version="1.2.1" date="2026-10-03">
      <description>
        <p>Stop the thumbnail grid from flickering while the window is resized.</p>
      </description>
    </release>
    <release version="1.2.0" date="2026-10-03">
      <description>
        <p>Give the thumbnail grid a cleaner look.</p>
        <ul>
          <li>Thumbnails sit in square frames, evenly spaced across the whole width.</li>
          <li>Favorites show a larger yellow star that grows with the thumbnails.</li>
          <li>A new preference hides the names under the thumbnails.</li>
          <li>Small images stay sharp, and the lasso shows the selection while it is drawn.</li>
        </ul>
      </description>
    </release>
    <release version="1.1.0" date="2026-10-03">
      <description>
        <p>Add a user guide, available from the main menu or with F1.</p>
      </description>
    </release>
    <release version="1.0.0" date="2026-10-03">
      <description>
        <p>The first public version of Pigoune.</p>
        <ul>
          <li>Import SVG, PNG, JPEG, WebP, GIF and ICO files, or whole folders, with duplicate detection</li>
          <li>Organize assets with nested collections, tags, favorites, notes and credits</li>
          <li>Find any asset instantly with search and filters</li>
          <li>Preview assets up close, animated GIFs included</li>
          <li>Reuse assets by dragging, copying or exporting them</li>
          <li>Undo changes and restore assets from the trash</li>
        </ul>
      </description>
    </release>
  </releases>
</component>
