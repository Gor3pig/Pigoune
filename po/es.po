msgid "{shortcut} is reserved by Pigoune."
msgstr "{shortcut} está reservado por Pigoune."

#: crates/pigoune-app/src/shortcuts_page.rs:228
msgid "This key combination is not supported."
msgstr "Esta combinación de teclas no es compatible."

