msgstr "Importar una carpeta"

#: crates/pigoune-app/src/shortcuts.rs:289
msgid "Export Assets"
msgstr "Exportar elementos"

#: crates/pigoune-app/src/shortcuts.rs:290
msgid "Convert and Export Assets"
msgstr "Convertir y exportar elementos"

#: crates/pigoune-app/src/shortcuts.rs:291
msgid "Open With Another Application"
msgstr "Abrir con otra aplicación"

#: crates/pigoune-app/src/shortcuts.rs:293
msgid "Set as Wallpaper"
msgstr "Establecer como fondo de pantalla"

#: crates/pigoune-app/src/shortcuts.rs:294
msgid "Restore Assets"
msgstr "Restaurar elementos"

#: crates/pigoune-app/src/shortcuts.rs:296
msgid "Empty the Trash"
msgstr "Vaciar la papelera"

#: crates/pigoune-app/src/shortcuts_page.rs:68
msgid "None"
msgstr "Ninguno"

#: crates/pigoune-app/src/shortcuts_page.rs:76
msgid "Reset to Default"
msgstr "Restablecer al valor predeterminado"

#: crates/pigoune-app/src/shortcuts_page.rs:83
msgid "Standard shortcut, it cannot be changed"
msgstr "Atajo estándar, no se puede cambiar"

#: crates/pigoune-app/src/shortcuts_page.rs:149
#, rust-format
msgid "Press the new key combination for “{name}”"
msgstr "Pulse la nueva combinación de teclas para «{name}»"

#: crates/pigoune-app/src/shortcuts_page.rs:150
msgid "Set the Shortcut"
msgstr "Definir el atajo"

#: crates/pigoune-app/src/shortcuts_page.rs:221
#, rust-format
msgid "{shortcut} is already used by “{name}”."
msgstr "{shortcut} ya lo usa «{name}»."

#: crates/pigoune-app/src/shortcuts_page.rs:224
msgid "Use Ctrl or Alt with a key, or a function key."
msgstr "Use Ctrl o Alt con una tecla, o una tecla de función."

#: crates/pigoune-app/src/shortcuts_page.rs:226
