msgstr "_Préférences"

#: crates/pigoune-app/ui/window.blp:264
msgid "_Keyboard Shortcuts"
msgstr "_Raccourcis clavier"

#: crates/pigoune-app/ui/window.blp:269
msgid "_Help"
msgstr "_Aide"

#: crates/pigoune-app/ui/window.blp:274
msgid "_About Pigoune"
msgstr "À _propos de Pigoune"

#: crates/pigoune-app/ui/new-library-dialog.blp:5
#: crates/pigoune-app/ui/shortcuts-dialog.blp:9
msgid "New Library"
msgstr "Nouvelle bibliothèque"

#: crates/pigoune-app/ui/new-library-dialog.blp:17
#: crates/pigoune-app/src/window.rs:1176 crates/pigoune-app/src/window.rs:2045
#: crates/pigoune-app/src/window.rs:2093 crates/pigoune-app/src/window.rs:2286
