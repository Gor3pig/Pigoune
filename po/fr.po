msgstr ""
"Les images sont copiées dans la bibliothèque. Les originaux ne sont pas "
"modifiés."

#: crates/pigoune-app/ui/window.blp:157
msgid "Your Library Is Empty"
msgstr "Votre bibliothèque est vide"

#: crates/pigoune-app/ui/window.blp:158
msgid "Imported icons, logos and illustrations will appear here."
msgstr "Les icônes, logos et illustrations importés apparaîtront ici."

#: crates/pigoune-app/ui/window.blp:166 crates/pigoune-app/ui/window.blp:238
msgid "Import _Files…"
msgstr "Importer des _fichiers…"

#: crates/pigoune-app/ui/window.blp:177 crates/pigoune-app/ui/window.blp:243
