#: data/io.github.gor3pig.Pigoune.desktop.in:3
msgid "Pigoune"
msgstr "Pigoune"

#: data/io.github.gor3pig.Pigoune.desktop.in:4
msgid "Organize, find and reuse your icons, logos and illustrations"
msgstr "Rangez, retrouvez et réutilisez vos icônes, logos et illustrations"

#: data/io.github.gor3pig.Pigoune.desktop.in:10
msgid "icons;logos;svg;assets;library;graphics;"
msgstr "icônes;logos;svg;ressources;bibliothèque;graphismes;images;"

#: data/io.github.gor3pig.Pigoune.metainfo.xml.in:8
msgid "Organize, find and reuse your graphic assets"
msgstr "Rangez, retrouvez et réutilisez vos ressources graphiques"

#: data/io.github.gor3pig.Pigoune.metainfo.xml.in:10
msgid ""
"Pigoune is a cozy box for your icons, logos and illustrations. Drop your "
"graphic assets in, and Pigoune keeps a safe copy, helps you organize them "
"and gives them back with a simple drag and drop."
msgstr ""
"Pigoune est une boîte réconfortante pour vos icônes, logos et illustrations. "
"Déposez-y vos ressources graphiques : Pigoune en garde une copie en lieu "
"sûr, vous aide à les organiser et vous les rend d'un simple glisser-déposer."

#: data/io.github.gor3pig.Pigoune.metainfo.xml.in:16
msgid "Import SVG, PNG, JPG, WebP, GIF and ICO files"
msgstr "Importez des fichiers SVG, PNG, JPG, WebP, GIF et ICO"

#: data/io.github.gor3pig.Pigoune.metainfo.xml.in:17
msgid "Organize with nested collections, tags and favorites"
msgstr "Organisez avec des collections imbriquées, des tags et des favoris"

#: data/io.github.gor3pig.Pigoune.metainfo.xml.in:18
msgid "Find anything instantly with search and filters"
msgstr "Retrouvez tout instantanément grâce à la recherche et aux filtres"

#: data/io.github.gor3pig.Pigoune.metainfo.xml.in:19
msgid "Reuse assets with drag and drop or the clipboard"
msgstr "Réutilisez vos ressources par glisser-déposer ou via le presse-papiers"

#: data/io.github.gor3pig.Pigoune.metainfo.xml.in:20
msgid "Portable libraries, fully local, original files never touched"
msgstr ""
"Bibliothèques portables, 100 % locales, fichiers d'origine jamais modifiés"

#: data/io.github.gor3pig.Pigoune.metainfo.xml.in:56
msgid "First development snapshot."
msgstr "Première version de développement."

#: data/io.github.gor3pig.Pigoune.gschema.xml:6
msgid "Last opened library"
msgstr "Dernière bibliothèque ouverte"

#: data/io.github.gor3pig.Pigoune.gschema.xml:7
msgid ""
"Path of the library reopened at startup. Empty when no library was left open."
msgstr ""
"Chemin de la bibliothèque rouverte au démarrage. Vide si aucune bibliothèque "
"n'était restée ouverte."

#: data/io.github.gor3pig.Pigoune.gschema.xml:11
msgid "Window width"
msgstr "Largeur de la fenêtre"

#: data/io.github.gor3pig.Pigoune.gschema.xml:15
msgid "Window height"
msgstr "Hauteur de la fenêtre"

#: data/io.github.gor3pig.Pigoune.gschema.xml:19
msgid "Window maximized"
msgstr "Fenêtre maximisée"

#: crates/pigoune-app/ui/window.blp:20
msgid "Main Menu"
msgstr "Menu principal"

#: crates/pigoune-app/ui/window.blp:33
msgid "Welcome to Pigoune"
msgstr "Bienvenue dans Pigoune"

#: crates/pigoune-app/ui/window.blp:34
msgid "The cozy box for your icons, logos and illustrations."
msgstr "La boîte réconfortante pour vos icônes, logos et illustrations."

#: crates/pigoune-app/ui/window.blp:46
msgid "_Create a Library"
msgstr "_Créer une bibliothèque"

#: crates/pigoune-app/ui/window.blp:57
msgid "_Open a Library"
msgstr "_Ouvrir une bibliothèque"

#: crates/pigoune-app/ui/window.blp:74
msgid "Your Library Is Empty"
msgstr "Votre bibliothèque est vide"

#: crates/pigoune-app/ui/window.blp:75
msgid "Imported icons, logos and illustrations will appear here."
msgstr "Les icônes, logos et illustrations importés apparaîtront ici."

#: crates/pigoune-app/ui/window.blp:85
msgid "_Close Library"
msgstr "_Fermer la bibliothèque"

#: crates/pigoune-app/ui/window.blp:92
msgid "_About Pigoune"
msgstr "À _propos de Pigoune"

#: crates/pigoune-app/ui/new-library-dialog.blp:5
msgid "New Library"
msgstr "Nouvelle bibliothèque"

#: crates/pigoune-app/ui/new-library-dialog.blp:17
msgid "_Cancel"
msgstr "_Annuler"

#: crates/pigoune-app/ui/new-library-dialog.blp:24
msgid "C_reate"
msgstr "C_réer"

#: crates/pigoune-app/ui/new-library-dialog.blp:38
msgid "Name"
msgstr "Nom"

#: crates/pigoune-app/ui/new-library-dialog.blp:39
msgid "My Library"
msgstr "Ma bibliothèque"

#: crates/pigoune-app/ui/new-library-dialog.blp:45
msgid "Location"
msgstr "Emplacement"

#: crates/pigoune-app/ui/new-library-dialog.blp:46
msgid "No folder chosen"
msgstr "Aucun dossier choisi"

#: crates/pigoune-app/ui/new-library-dialog.blp:51
msgid "_Choose…"
msgstr "_Choisir…"

#: crates/pigoune-app/src/application.rs:55
msgid "translator-credits"
msgstr "Gor3pig"

#: crates/pigoune-app/src/error_messages.rs:7
msgid "This name cannot be used. Avoid “/” and names starting with a dot."
msgstr ""
"Ce nom ne peut pas être utilisé. Évitez « / » et les noms commençant par un "
"point."

#: crates/pigoune-app/src/error_messages.rs:10
msgid "A file or folder with this name already exists here."
msgstr "Un fichier ou un dossier portant ce nom existe déjà ici."

#: crates/pigoune-app/src/error_messages.rs:13
msgid ""
"The library folder could not be found. It may have been moved, renamed or "
"deleted, or it may be on a disk that is no longer connected."
msgstr ""
"Le dossier de la bibliothèque est introuvable. Il a peut-être été déplacé, "
"renommé ou supprimé, ou se trouve sur un disque qui n'est plus connecté."

#: crates/pigoune-app/src/error_messages.rs:15
msgid "This folder is not a Pigoune library."
msgstr "Ce dossier n'est pas une bibliothèque Pigoune."

#: crates/pigoune-app/src/error_messages.rs:17
msgid ""
"This library was created by a newer version of Pigoune. Update Pigoune to "
"open it."
msgstr ""
"Cette bibliothèque a été créée par une version plus récente de Pigoune. "
"Mettez Pigoune à jour pour l'ouvrir."

#: crates/pigoune-app/src/error_messages.rs:19
msgid "This library is already open in another Pigoune window."
msgstr "Cette bibliothèque est déjà ouverte dans une autre fenêtre de Pigoune."

#: crates/pigoune-app/src/error_messages.rs:21
msgid ""
"There is not enough free space on the disk. Free up some space and try again."
msgstr ""
"Il n'y a plus assez d'espace sur le disque. Libérez de la place puis "
"réessayez."

#: crates/pigoune-app/src/error_messages.rs:24
msgid ""
"Pigoune is not allowed to write to this location. Choose another folder."
msgstr ""
"Pigoune n'a pas l'autorisation d'écrire à cet emplacement. Choisissez un "
"autre dossier."

#: crates/pigoune-app/src/error_messages.rs:27
msgid ""
"This library seems to be damaged. Your files are still in its “files” folder."
msgstr ""
"Cette bibliothèque semble endommagée. Vos fichiers sont toujours dans son "
"dossier « files »."

#: crates/pigoune-app/src/error_messages.rs:30
#, rust-format
msgid "An unexpected error occurred: {error}"
msgstr "Une erreur inattendue s'est produite : {error}"

#: crates/pigoune-app/src/new_library_dialog.rs:101
msgid "Choose a Location"
msgstr "Choisir un emplacement"

#: crates/pigoune-app/src/window.rs:153
msgid "_Open Another Library…"
msgstr "_Ouvrir une autre bibliothèque…"

#: crates/pigoune-app/src/window.rs:154
msgid "_Try Again"
msgstr "_Réessayer"

#: crates/pigoune-app/src/window.rs:186
msgid "Open a Pigoune Library"
msgstr "Ouvrir une bibliothèque Pigoune"

#: crates/pigoune-app/src/window.rs:261
#, rust-format
msgid "Unable to Open “{name}”"
msgstr "Impossible d'ouvrir « {name} »"

#: crates/pigoune-app/src/window.rs:263
msgid "_Close"
msgstr "_Fermer"
