#: crates/pigoune-app/src/window.rs:104 crates/pigoune-app/src/window.rs:313
msgid "Create Library"
msgstr "Créer une bibliothèque"

#: crates/pigoune-app/src/window.rs:111 crates/pigoune-app/src/window.rs:176
msgid "Create Elsewhere…"
msgstr "Créer ailleurs…"

#: crates/pigoune-app/src/window.rs:114 crates/pigoune-app/src/window.rs:172
msgid "Open Library…"
msgstr "Ouvrir une bibliothèque…"

#: crates/pigoune-app/src/window.rs:119
msgid "Welcome to Pigoune"
msgstr "Bienvenue dans Pigoune"

#: crates/pigoune-app/src/window.rs:120
msgid "Create a library or open an existing one."
msgstr "Créez une bibliothèque ou ouvrez-en une existante."

#: crates/pigoune-app/src/window.rs:132
msgid "Opening library…"
msgstr "Ouverture de la bibliothèque…"

#: crates/pigoune-app/src/window.rs:145
msgid "Library"
msgstr "Bibliothèque"

#: crates/pigoune-app/src/window.rs:151
msgid "Library is open"
msgstr "Bibliothèque ouverte"

#: crates/pigoune-app/src/window.rs:162
msgid ""
"The library is open, but Pigoune could not confirm that its location was "
"saved."
msgstr ""
"La bibliothèque est ouverte, mais Pigoune n’a pas pu confirmer "
"l’enregistrement de son emplacement."

#: crates/pigoune-app/src/window.rs:167
msgid "Retry saving location"
msgstr "Réessayer d’enregistrer l’emplacement"

#: crates/pigoune-app/src/window.rs:195
msgid "Library location unavailable"
msgstr "Emplacement de bibliothèque indisponible"

#: crates/pigoune-app/src/window.rs:196
msgid "The library location cannot be accessed."
msgstr "Impossible d’accéder à l’emplacement de la bibliothèque."

#: crates/pigoune-app/src/window.rs:199
msgid "Library storage unavailable"
msgstr "Stockage de la bibliothèque indisponible"

#: crates/pigoune-app/src/window.rs:200
msgid ""
"This location cannot complete the file operations required by a library."
msgstr ""
"Cet emplacement ne permet pas les opérations de fichiers nécessaires à une "
"bibliothèque."

#: crates/pigoune-app/src/window.rs:203
msgid "Not a Pigoune library"
msgstr "Ce dossier n’est pas une bibliothèque Pigoune"

#: crates/pigoune-app/src/window.rs:204
msgid "The selected folder does not contain a complete Pigoune library."
msgstr "Le dossier choisi ne contient pas de bibliothèque Pigoune complète."

#: crates/pigoune-app/src/window.rs:207
msgid "Invalid library"
msgstr "Bibliothèque invalide"

#: crates/pigoune-app/src/window.rs:208
msgid "The library contains invalid data and could not be opened."
msgstr ""
"La bibliothèque contient des données invalides et ne peut pas être ouverte."

#: crates/pigoune-app/src/window.rs:211
msgid "Incompatible library version"
msgstr "Version de bibliothèque incompatible"

#: crates/pigoune-app/src/window.rs:212
msgid "This version of Pigoune cannot open this library."
msgstr "Cette version de Pigoune ne peut pas ouvrir cette bibliothèque."

#: crates/pigoune-app/src/window.rs:215
msgid "Invalid application configuration"
msgstr "Configuration de l’application invalide"

#: crates/pigoune-app/src/window.rs:216
msgid "The saved library location is invalid."
msgstr "L’emplacement de bibliothèque enregistré est invalide."

#: crates/pigoune-app/src/window.rs:219
msgid "Could not update configuration"
msgstr "Impossible de modifier la configuration"

#: crates/pigoune-app/src/window.rs:220
msgid "The library location could not be forgotten."
msgstr "Impossible d’oublier l’emplacement de la bibliothèque."

#: crates/pigoune-app/src/window.rs:223
msgid "Could not confirm the configuration change"
msgstr "Modification de la configuration non confirmée"

#: crates/pigoune-app/src/window.rs:225
msgid ""
"The library location was removed, but the change could not be confirmed on "
"disk. Retry before closing Pigoune."
msgstr ""
"L’emplacement de la bibliothèque a été supprimé de la configuration, mais "
"Pigoune n’a pas pu confirmer l’enregistrement sur le disque. Réessayez avant "
"de fermer Pigoune."

#: crates/pigoune-app/src/window.rs:229
msgid "Library already exists"
msgstr "Une bibliothèque existe déjà"

#: crates/pigoune-app/src/window.rs:230
msgid "The destination already contains a folder. It was not replaced."
msgstr "La destination contient déjà un dossier. Il n’a pas été remplacé."

#: crates/pigoune-app/src/window.rs:233
msgid "Open Another Library…"
msgstr "Ouvrir une autre bibliothèque…"

#: crates/pigoune-app/src/window.rs:238
msgid "Back to Library"
msgstr "Retour à la bibliothèque"

#: crates/pigoune-app/src/window.rs:244
msgid "Retry"
msgstr "Réessayer"

#: crates/pigoune-app/src/window.rs:254
msgid "Open Existing Library"
msgstr "Ouvrir la bibliothèque existante"

#: crates/pigoune-app/src/window.rs:264
msgid "Retry saving change"
msgstr "Réessayer d’enregistrer la modification"

#: crates/pigoune-app/src/window.rs:266
msgid "Forget this library location"
msgstr "Oublier cet emplacement de bibliothèque"

#: crates/pigoune-app/src/window.rs:284
msgid "Choose a parent folder"
msgstr "Choisir un dossier parent"

#: crates/pigoune-app/src/window.rs:286
msgid "Open Library"
msgstr "Ouvrir une bibliothèque"

#: crates/pigoune-app/src/window.rs:310
msgid "New library folder"
msgstr "Nouveau dossier de bibliothèque"

#: crates/pigoune-app/src/window.rs:312
msgid "Cancel"
msgstr "Annuler"

#: crates/pigoune-app/src/window.rs:316
msgid "Folder name"
msgstr "Nom du dossier"

#: crates/pigoune-app/src/window.rs:329
msgid "Enter a single folder name without a slash."
msgstr "Saisissez un seul nom de dossier, sans barre oblique."

#: crates/pigoune-app/src/window.rs:348
msgid "Location unavailable"
msgstr "Emplacement indisponible"

#: crates/pigoune-app/src/window.rs:349
msgid "Choose a local folder that Pigoune can access."
msgstr "Choisissez un dossier local auquel Pigoune peut accéder."

#: crates/pigoune-app/src/window.rs:351
msgid "Close"
msgstr "Fermer"
