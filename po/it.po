#: crates/pigoune-app/ui/wallpaper-dialog.blp:5
#: crates/pigoune-app/ui/wallpaper-dialog.blp:27
msgid "Frame the Wallpaper"
msgstr "Inquadra lo sfondo"

#: crates/pigoune-app/ui/wallpaper-dialog.blp:39
msgid "_Set as Wallpaper"
msgstr "_Imposta come sfondo"

#: crates/pigoune-app/ui/wallpaper-dialog.blp:107
msgid "Screen"
msgstr "Schermo"

#: crates/pigoune-app/ui/wallpaper-dialog.blp:159
msgid "100%: one pixel of the image for one pixel of the screen"
msgstr "100%: un pixel dell’immagine per ogni pixel dello schermo"

#: crates/pigoune-app/ui/wallpaper-dialog.blp:173
msgid "Fill"
msgstr "Riempi"

#: crates/pigoune-app/ui/wallpaper-dialog.blp:174
msgid ""
"Covers the whole screen, as the desktop does; the edges that go past it are "
"cut"
msgstr ""
"Copre tutto lo schermo, come fa il desktop; i bordi in eccesso vengono "
"tagliati"

#: crates/pigoune-app/ui/wallpaper-dialog.blp:179
msgid "Whole"
msgstr "Intera"

#: crates/pigoune-app/ui/wallpaper-dialog.blp:180
msgid ""
"Shows the whole image; the rest of the screen is filled as chosen under "
"Empty Space"
msgstr ""
"Mostra l’immagine intera; il resto dello schermo è riempito come scelto in "
"“Spazio vuoto”"

#: crates/pigoune-app/ui/wallpaper-dialog.blp:185
msgid ""
"One pixel of the image for one pixel of the screen, for the sharpest result"
msgstr ""
"Un pixel dell’immagine per ogni pixel dello schermo, per la massima nitidezza"

#: crates/pigoune-app/ui/wallpaper-dialog.blp:201
msgid "Empty Space"
msgstr "Spazio vuoto"

#: crates/pigoune-app/ui/wallpaper-dialog.blp:210
msgid "Visible when the image does not cover the whole screen"
msgstr "Visibile quando l’immagine non copre tutto lo schermo"

#: crates/pigoune-app/ui/wallpaper-dialog.blp:232
msgid "Blur"
msgstr "Sfocatura"

#: crates/pigoune-app/ui/wallpaper-dialog.blp:245
msgid "Background Color"
msgstr "Colore di sfondo"

#: crates/pigoune-app/ui/wallpaper-dialog.blp:262
msgid "Simulation"
msgstr "Simulazione"

#: crates/pigoune-app/ui/wallpaper-dialog.blp:265
msgid "Desktop Simulation"
msgstr "Simulazione del desktop"

#: crates/pigoune-app/ui/wallpaper-dialog.blp:266
msgid ""
"Shows the bars of your desktop over the image, to judge the framing. They "
"are not part of the wallpaper."
msgstr ""
"Mostra le barre del tuo desktop sopra l’immagine, per giudicare "
"l’inquadratura. Non fanno parte dello sfondo."

#: crates/pigoune-app/ui/wallpaper-dialog.blp:272
msgid "Desktop"
msgstr "Desktop"

#: crates/pigoune-app/ui/wallpaper-dialog.blp:290
msgid "Also Add the Edited Version to the Library"
msgstr "Aggiungi anche la versione modificata alla libreria"

#: crates/pigoune-app/ui/wallpaper-dialog.blp:291
msgid ""
"The framed image, at the size of the screen, becomes a new resource. The "
"original image stays untouched."
msgstr ""
"L’immagine inquadrata, alla dimensione dello schermo, diventa una nuova "
"risorsa. L’immagine originale resta intatta."

#: crates/pigoune-app/src/wallpaper_dialog.rs:135
msgid ""
"Drag the image to move it, use the mouse wheel to zoom and the arrow keys to "
"adjust it"
msgstr ""
"Trascina l’immagine per spostarla, usa la rotellina per lo zoom e le frecce "
"per regolarla"

#: crates/pigoune-app/src/wallpaper_dialog.rs:195
#, rust-format
msgid "Image enlarged to {percent}: it will look blurry on this screen"
msgstr "Immagine ingrandita al {percent}: apparirà sfocata su questo schermo"

#: crates/pigoune-app/src/wallpaper_dialog.rs:388
msgid ""
"Full screen simulation: the wallpaper is not set yet. Press Esc to come back."
msgstr "Simulazione a schermo intero: lo sfondo non è ancora impostato. Premi Esc per tornare."

#: crates/pigoune-app/src/wallpaper_dialog.rs:455
