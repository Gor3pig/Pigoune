msgid "Leave Out of Duplicate Search"
msgstr "Excluir da busca de duplicatas"

#: crates/pigoune-app/src/collection_skipping.rs:40
msgid "Include in Duplicate Search"
msgstr "Incluir na busca de duplicatas"

#: crates/pigoune-app/src/collection_skipping.rs:42
#, rust-format
msgid "Left Out Through “{name}”"
msgstr "Excluída por meio de “{name}”"

#: crates/pigoune-app/src/collection_skipping.rs:99
msgid "At the top level"
msgstr "No nível superior"

#: crates/pigoune-app/src/collection_skipping.rs:105
#, rust-format
msgid "{count} sub-collection is left out with it"
