msgstr "Visível quando a imagem não cobre a tela inteira"

#: crates/pigoune-app/ui/wallpaper-dialog.blp:272
msgid "Gradient"
msgstr "Gradiente"

#: crates/pigoune-app/ui/wallpaper-dialog.blp:282
