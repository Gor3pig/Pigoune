#: crates/pigoune-app/ui/wallpaper-dialog.blp:5
#: crates/pigoune-app/ui/wallpaper-dialog.blp:33
msgid "Frame the Wallpaper"
msgstr "Enquadrar o papel de parede"

#: crates/pigoune-app/ui/wallpaper-dialog.blp:49
msgid "_Set as Wallpaper"
msgstr "_Definir como papel de parede"

#: crates/pigoune-app/ui/wallpaper-dialog.blp:132
msgid "100%: one pixel of the image for one pixel of the screen"
msgstr "100%: um pixel da imagem para cada pixel da tela"

#: crates/pigoune-app/ui/wallpaper-dialog.blp:146
msgid "Fill"
msgstr "Preencher"

#: crates/pigoune-app/ui/wallpaper-dialog.blp:147
msgid ""
"Covers the whole screen, as the desktop does; the edges that go past it are "
"cut"
msgstr ""
"Cobre a tela inteira, como faz a área de trabalho; as bordas que sobram são "
"cortadas"

#: crates/pigoune-app/ui/wallpaper-dialog.blp:152
msgid "Whole"
msgstr "Inteira"

#: crates/pigoune-app/ui/wallpaper-dialog.blp:153
msgid ""
"Shows the whole image; the rest of the screen is filled as chosen under "
"Empty Space"
msgstr ""
"Mostra a imagem inteira; o resto da tela é preenchido conforme escolhido em "
"“Espaço vazio”"

#: crates/pigoune-app/ui/wallpaper-dialog.blp:158
msgid ""
"One pixel of the image for one pixel of the screen, for the sharpest result"
msgstr "Um pixel da imagem para cada pixel da tela, para a maior nitidez"

#: crates/pigoune-app/ui/wallpaper-dialog.blp:172
msgid "Mirror"
msgstr "Espelhar"

#: crates/pigoune-app/ui/wallpaper-dialog.blp:173
msgid "Flips the image from left to right, in the wallpaper only"
msgstr "Inverte a imagem da esquerda para a direita, só no papel de parede"

#: crates/pigoune-app/ui/wallpaper-dialog.blp:178
msgid "Thirds"
msgstr "Terços"

#: crates/pigoune-app/ui/wallpaper-dialog.blp:179
msgid "Shows the rule of thirds grid, to place the subject"
msgstr "Mostra a grade dos terços, para posicionar o assunto"

#: crates/pigoune-app/ui/wallpaper-dialog.blp:184
msgid "Snap"
msgstr "Ímã"

#: crates/pigoune-app/ui/wallpaper-dialog.blp:185
msgid ""
"While dragging, the image snaps to the center and the edges of the screen"
msgstr "Ao arrastar, a imagem se encaixa no centro e nas bordas da tela"

#: crates/pigoune-app/ui/wallpaper-dialog.blp:217
msgid "Screen"
msgstr "Tela"

#: crates/pigoune-app/ui/wallpaper-dialog.blp:242
msgid "Empty Space"
msgstr "Espaço vazio"

#: crates/pigoune-app/ui/wallpaper-dialog.blp:251
msgid "Visible when the image does not cover the whole screen"
msgstr "Visível quando a imagem não cobre a tela inteira"

#: crates/pigoune-app/ui/wallpaper-dialog.blp:272
msgid "Gradient"
msgstr "Gradiente"

#: crates/pigoune-app/ui/wallpaper-dialog.blp:277
msgid "Blur"
msgstr "Desfoque"

#: crates/pigoune-app/ui/wallpaper-dialog.blp:282
msgid "Mosaic"
msgstr "Mosaico"

#: crates/pigoune-app/ui/wallpaper-dialog.blp:312
msgid "Angle"
msgstr "Ângulo"

#: crates/pigoune-app/ui/wallpaper-dialog.blp:318
msgid "Direction of the gradient: 0° goes up, 90° to the right, 180° down"
msgstr ""
"Direção do gradiente: 0° para cima, 90° para a direita, 180° para baixo"

#: crates/pigoune-app/ui/wallpaper-dialog.blp:348
msgid "Start Color"
msgstr "Cor inicial"

#: crates/pigoune-app/ui/wallpaper-dialog.blp:354
msgid "Choose the start color"
msgstr "Escolher a cor inicial"

#: crates/pigoune-app/ui/wallpaper-dialog.blp:364
msgid "End Color"
msgstr "Cor final"

#: crates/pigoune-app/ui/wallpaper-dialog.blp:370
msgid "Choose the end color"
msgstr "Escolher a cor final"

#: crates/pigoune-app/ui/wallpaper-dialog.blp:386
msgid "Swap Colors"
msgstr "Inverter cores"

#: crates/pigoune-app/ui/wallpaper-dialog.blp:397
msgid "Image"
msgstr "Imagem"

#: crates/pigoune-app/ui/wallpaper-dialog.blp:403
msgid "Darken"
msgstr "Escurecer"

#: crates/pigoune-app/ui/wallpaper-dialog.blp:409
msgid "Darkens the whole wallpaper so that icons and bars stay readable"
msgstr ""
"Escurece todo o papel de parede para que ícones e barras continuem legíveis"

#: crates/pigoune-app/ui/wallpaper-dialog.blp:432
msgid "Simulation"
msgstr "Simulação"

#: crates/pigoune-app/ui/wallpaper-dialog.blp:435
msgid "Desktop Simulation"
msgstr "Simulação da área de trabalho"

#: crates/pigoune-app/ui/wallpaper-dialog.blp:436
msgid ""
"Shows the bars of your desktop over the image, to judge the framing. They "
"are not part of the wallpaper."
msgstr ""
"Mostra as barras da sua área de trabalho sobre a imagem, para avaliar o "
"enquadramento. Elas não fazem parte do papel de parede."

#: crates/pigoune-app/ui/wallpaper-dialog.blp:442
msgid "Desktop"
msgstr "Área de trabalho"

#: crates/pigoune-app/ui/wallpaper-dialog.blp:461
msgid ""
"The framed image, at the size of the screen, becomes a new resource. The "
"original image stays untouched."
msgstr ""
"A imagem enquadrada, no tamanho da tela, vira um novo recurso. A imagem "
"original fica intacta."

#: crates/pigoune-app/ui/wallpaper-dialog.blp:464
msgid "Also Add the Edited Version to the Library"
msgstr "Adicionar também a versão editada à biblioteca"

#: crates/pigoune-app/src/wallpaper_dialog.rs:181
msgid ""
"Drag the image to move it, use the mouse wheel to zoom and the arrow keys to "
"adjust it"
msgstr ""
"Arraste a imagem para movê-la, use a roda do mouse para ampliar e as setas "
"para ajustá-la"

#: crates/pigoune-app/src/wallpaper_dialog.rs:243
#, rust-format
msgid "Image enlarged to {percent}: it will look blurry on this screen"
msgstr "Imagem ampliada para {percent}: ela ficará desfocada nesta tela"

#: crates/pigoune-app/src/wallpaper_dialog.rs:376
msgid "Colors of the image, or another color"
msgstr "Cores da imagem, ou outra cor"

#: crates/pigoune-app/src/wallpaper_dialog.rs:381
#, rust-format
msgid "{angle}°"
msgstr "{angle}°"

#: crates/pigoune-app/src/wallpaper_dialog.rs:432
msgid ""
"GNOME shows the same wallpaper on every screen: it is prepared for the one "
"chosen here"
msgstr ""
"O GNOME mostra o mesmo papel de parede em todas as telas: ele é preparado "
"para a escolhida aqui"

#: crates/pigoune-app/src/wallpaper_dialog.rs:437
msgid "Prepare For"
msgstr "Preparar para"

#: crates/pigoune-app/src/wallpaper_dialog.rs:620
msgid ""
"Full screen simulation: the wallpaper is not set yet. Press Esc to come back."
msgstr ""
"Simulação em tela cheia: o papel de parede ainda não foi definido. Pressione "
"Esc para voltar."

#: crates/pigoune-app/src/wallpaper_dialog.rs:694
#, rust-format
msgid "{width} × {height} pixels, the screen where Pigoune is shown"
msgstr "{width} × {height} pixels, a tela onde o Pigoune é exibido"

